---
import { Image } from 'astro:assets';
import tabDifferent from '@/assets/about/tab-different.webp';
import tabMission from '@/assets/about/tab-mission.webp';
import tabProcess from '@/assets/about/tab-process.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section id="about-details" class:list={['about-details-section', className]}>
  <div class="about-wrap">
    
    <!-- Header -->
    <header class="about-head">
      <div class="about-kicker" aria-label="Section label">
        <span class="pill-light">About CFS Flooring</span>
        <span class="kicker-text">Washington • Oregon • Residential & Commercial Flooring</span>
      </div>

      <h2 class="about-h2">
        Flooring expertise built on honest guidance, quality craftsmanship, and a smoother process.
      </h2>

      <p class="about-sub">
        CFS Flooring helps homeowners and businesses upgrade, restore, and improve their spaces with dependable flooring solutions. We focus on clear communication, practical recommendations, and quality results that look great and hold up over time.
      </p>

      <div class="about-cta">
        <button class="btn-primary" type="button" @click="$dispatch('open-drawer')">
          <span>Get a Quote</span>
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </button>
      </div>
    </header>

    <!-- Main Grid -->
    <div class="about-grid" x-data="{ activeTab: 'different', openAcc: 0, isSwapping: false }">
      
      <!-- LEFT: Animated Tabbed Image Slider -->
      <aside class="about-media" aria-label="About images">
        <div class="about-slider" :class="{ 'is-swapping': isSwapping }">
          
          <div x-show="activeTab === 'different'" x-transition:enter="slide-entering" class="slide-item">
            <Image
              src={tabDifferent}
              alt="CFS Flooring project showcase"
              class="slide-img"
              loading="eager"
            />
          </div>

          <div x-show="activeTab === 'mission'" x-transition:enter="slide-entering" class="slide-item">
            <Image
              src={tabMission}
              alt="CFS Flooring installation detail"
              class="slide-img"
              loading="eager"
            />
          </div>

          <div x-show="activeTab === 'process'" x-transition:enter="slide-entering" class="slide-item">
            <Image
              src={tabProcess}
              alt="CFS Flooring process and craftsmanship"
              class="slide-img"
              loading="eager"
            />
          </div>

          <!-- Sweep Light Reflection Overlay -->
          <span class="slide-sweep" aria-hidden="true"></span>
        </div>
      </aside>

      <!-- RIGHT: Tabbed Content Container -->
      <div class="about-panels-box" aria-label="About content sections">
        
        <!-- Tab Bar -->
        <div class="tabbar" role="tablist" aria-label="About tabs">
          <button
            class="tab-btn"
            :class="{ 'is-active': activeTab === 'different' }"
            type="button"
            role="tab"
            :aria-selected="activeTab === 'different'"
            @click="if(activeTab !== 'different'){ isSwapping = true; activeTab = 'different'; setTimeout(() => isSwapping = false, 300); }"
          >
            What Makes Us Different
          </button>

          <button
            class="tab-btn"
            :class="{ 'is-active': activeTab === 'mission' }"
            type="button"
            role="tab"
            :aria-selected="activeTab === 'mission'"
            @click="if(activeTab !== 'mission'){ isSwapping = true; activeTab = 'mission'; setTimeout(() => isSwapping = false, 300); }"
          >
            Our Mission
          </button>

          <button
            class="tab-btn"
            :class="{ 'is-active': activeTab === 'process' }"
            type="button"
            role="tab"
            :aria-selected="activeTab === 'process'"
            @click="if(activeTab !== 'process'){ isSwapping = true; activeTab = 'process'; setTimeout(() => isSwapping = false, 300); }"
          >
            Our Process
          </button>
        </div>

        <div class="panelwrap">
          
          <!-- TAB 1: What Makes Us Different -->
          <section class="panel-item" x-show="activeTab === 'different'" x-cloak role="tabpanel">
            <h3 class="panel-h3">What makes CFS Flooring different from the competition</h3>
            <p class="panel-p">
              Choosing a flooring company is about more than finding someone to install material. You need a team that communicates clearly, recommends the right solution for your space, and delivers results with care. At CFS Flooring, we focus on honest guidance, cleaner execution, and long-term value instead of rushed work or one-size-fits-all recommendations.
            </p>

            <ul class="bullet-list" aria-label="What makes us different bullets">
              <li>
                <span class="dot" aria-hidden="true"></span>
                <span><strong>Honest recommendations</strong> based on your goals, space, and budget.</span>
              </li>
              <li>
                <span class="dot" aria-hidden="true"></span>
                <span><strong>Attention to prep and detail</strong> so the finished floor looks better and lasts longer.</span>
              </li>
              <li>
                <span class="dot" aria-hidden="true"></span>
                <span><strong>Clear communication</strong> from estimate to final walkthrough, without the guesswork.</span>
              </li>
            </ul>

            <div class="callout-box">
              <div class="callout-title">Built for better long-term results</div>
              <div class="callout-text">
                We care about how your floors perform after the project is done, not just how they look the day we finish.
              </div>
            </div>
          </section>

          <!-- TAB 2: Our Mission -->
          <section class="panel-item" x-show="activeTab === 'mission'" x-cloak role="tabpanel">
            <h3 class="panel-h3">Our mission</h3>
            <p class="panel-p">
              Our mission is to help homeowners and businesses improve their spaces with flooring solutions that combine style, durability, and practical value. We believe every project should be handled with professionalism, honest guidance, and workmanship clients can feel confident in.
            </p>

            <div class="mission-grid" aria-label="Mission pillars">
              <article class="mission-card">
                <div class="card-top">
                  <span class="card-icon" aria-hidden="true">1</span>
                  <h4 class="card-h4">Guide</h4>
                </div>
                <p class="card-p2">Help you choose the right flooring option for your space, budget, and long-term goals.</p>
              </article>

              <article class="mission-card">
                <div class="card-top">
                  <span class="card-icon" aria-hidden="true">2</span>
                  <h4 class="card-h4">Install</h4>
                </div>
                <p class="card-p2">Complete the work with attention to detail, reliable execution, and quality craftsmanship.</p>
              </article>

              <article class="mission-card">
                <div class="card-top">
                  <span class="card-icon" aria-hidden="true">3</span>
                  <h4 class="card-h4">Deliver</h4>
                </div>
                <p class="card-p2">Leave you with flooring that improves the comfort, function, and appearance of your space.</p>
              </article>
            </div>
          </section>

          <!-- TAB 3: Our Process -->
          <section class="panel-item" x-show="activeTab === 'process'" x-cloak role="tabpanel">
            <h3 class="panel-h3">Our process</h3>
            <p class="panel-p">
              We keep every flooring project organized so you know what to expect from the first conversation through the final walkthrough.
            </p>

            <div class="acc-box" aria-label="Process steps accordion">
              
              <!-- Accordion 1 -->
              <div class="acc-item" :class="{ 'is-open': openAcc === 0 }">
                <button class="acc-btn" type="button" @click="openAcc = (openAcc === 0 ? null : 0)">
                  <span>01) Consultation & Material Guidance</span>
                  <span class="acc-plus" aria-hidden="true">+</span>
                </button>
                <div class="acc-panel" x-show="openAcc === 0" x-collapse>
                  <div class="acc-inner">
                    We start by understanding your space, goals, budget, and timeline. Then we help you choose the right flooring option, whether that means hardwood, laminate, LVP, carpet, tile, or sheet vinyl.
                  </div>
                </div>
              </div>

              <!-- Accordion 2 -->
              <div class="acc-item" :class="{ 'is-open': openAcc === 1 }">
                <button class="acc-btn" type="button" @click="openAcc = (openAcc === 1 ? null : 1)">
                  <span>02) Honest Quote & Clear Plan</span>
                  <span class="acc-plus" aria-hidden="true">+</span>
                </button>
                <div class="acc-panel" x-show="openAcc === 1" x-collapse>
                  <div class="acc-inner">
                    You get a straightforward quote and realistic expectations before work begins. We explain what makes sense for your project, including when a simpler option is the smarter investment.
                  </div>
                </div>
              </div>

              <!-- Accordion 3 -->
              <div class="acc-item" :class="{ 'is-open': openAcc === 2 }">
                <button class="acc-btn" type="button" @click="openAcc = (openAcc === 2 ? null : 2)">
                  <span>03) Installation, Sanding, or Removal</span>
                  <span class="acc-plus" aria-hidden="true">+</span>
                </button>
                <div class="acc-panel" x-show="openAcc === 2" x-collapse>
                  <div class="acc-inner">
                    Once approved, we complete the work with attention to labor quality and clean execution. That includes new flooring installation, hardwood sand and finish, tile work, or flooring removal.
                  </div>
                </div>
              </div>

              <!-- Accordion 4 -->
              <div class="acc-item" :class="{ 'is-open': openAcc === 3 }">
                <button class="acc-btn" type="button" @click="openAcc = (openAcc === 3 ? null : 3)">
                  <span>04) Final Walkthrough & Local Support</span>
                  <span class="acc-plus" aria-hidden="true">+</span>
                </button>
                <div class="acc-panel" x-show="openAcc === 3" x-collapse>
                  <div class="acc-inner">
                    We finish with a walkthrough to make sure the details are right and the result matches the plan. CFS Flooring proudly serves Lake Oswego, West Linn, and Wilsonville with responsive, local service.
                  </div>
                </div>
              </div>

            </div>

            <div class="callout-box callout-accent">
              <div class="callout-title">End result</div>
              <div class="callout-text">
                A clear plan, quality workmanship, and a finished floor that fits your space and goals.
              </div>
            </div>
          </section>

        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .about-details-section {
    font-family: var(--font-body);
    background: #ffffff;
    color: var(--color-text);
    padding: 92px 0;
    border-bottom: 1px solid var(--color-stroke);
    box-sizing: border-box;
  }

  .about-details-section * {
    box-sizing: border-box;
  }

  .about-wrap {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 22px;
  }

  .about-head {
    width: 100%;
    margin: 0 0 44px;
  }

  .about-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    font-family: var(--font-body);
    color: var(--color-muted);
    font-size: 14px;
    letter-spacing: 0.2px;
  }

  .pill-light {
    display: inline-flex;
    align-items: center;
    padding: 8px 13px;
    border-radius: 999px;
    border: 1px solid var(--color-accent-2);
    background: #ffffff;
    color: var(--color-text);
    font-weight: 900;
    font-size: 13px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.05);
  }

  .kicker-text {
    color: var(--color-muted);
    font-weight: 700;
  }

  .about-h2 {
    margin: 0 0 16px;
    font-family: var(--font-title);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.8px;
    font-size: clamp(38px, 4.25vw, 62px);
    color: var(--color-text);
    max-width: 24ch;
  }

  .about-sub {
    margin: 0 0 24px;
    font-family: var(--font-body);
    color: var(--color-muted);
    line-height: 1.85;
    font-size: 18px;
    font-weight: 400;
    max-width: 1080px;
  }

  .about-cta {
    display: flex;
    gap: 12px;
  }

  .about-details-section .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 900;
    letter-spacing: 0.01em;
    border-radius: 16px;
    padding: 14px 20px;
    transition: transform 0.25s ease, box-shadow 0.35s ease, background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    border: 1px solid var(--color-accent-2);
    white-space: nowrap;
    font-family: var(--font-body);
    background: var(--color-accent-2);
    color: var(--color-dark-bg);
    box-shadow: 0 4px 12px rgba(247, 209, 51, 0.25);
    cursor: pointer;
  }

  .about-details-section .btn-primary:hover {
    transform: translateY(-1px);
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .about-details-section .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 42px;
    align-items: stretch;
  }

  .about-media {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .about-slider {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 560px;
    overflow: visible;
    border-radius: 18px;
  }

  .slide-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.10);
    border: 1px solid var(--color-stroke);
    background: #ffffff;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Wipe In animation */
  @keyframes cfsWipeIn {
    0% {
      clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
      transform: scale(1.028);
      filter: blur(0.5px) saturate(1.04);
    }
    100% {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      transform: scale(1);
      filter: blur(0) saturate(1.02);
    }
  }

  .slide-entering {
    animation: cfsWipeIn 0.28s ease both;
  }

  /* Sweep Light Reflection Overlay */
  .slide-sweep {
    position: absolute;
    inset: -10% -20%;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-18%) rotate(-10deg);
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.03) 38%,
      color-mix(in srgb, var(--color-accent) 26%, transparent) 55%,
      transparent 72%
    );
    filter: blur(2px);
    z-index: 10;
  }

  .about-slider.is-swapping .slide-sweep {
    opacity: 1;
    animation: cfsSweep 0.3s ease both;
  }

  @keyframes cfsSweep {
    0% {
      transform: translateX(-22%) rotate(-10deg);
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    100% {
      transform: translateX(28%) rotate(-10deg);
      opacity: 0;
    }
  }

  .about-panels-box {
    min-height: 560px;
    border: 1px solid var(--color-stroke);
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.10);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .tabbar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--color-stroke);
    background: #ffffff;
  }

  .tab-btn {
    padding: 14px 12px;
    border-radius: 16px;
    border: 1px solid var(--color-stroke);
    background: #ffffff;
    font-weight: 900;
    font-size: 14px;
    color: var(--color-text);
    font-family: var(--font-body);
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    text-align: center;
  }

  .tab-btn:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent-2);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.06);
  }

  .tab-btn.is-active {
    background: color-mix(in srgb, var(--color-accent) 10%, #ffffff);
    border-color: var(--color-accent-2);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
  }

  .panelwrap {
    padding: 26px;
    flex: 1 1 auto;
    background: #ffffff;
  }

  .panel-h3 {
    margin: 0 0 14px;
    font-family: var(--font-title);
    font-size: 26px;
    letter-spacing: -0.4px;
    font-weight: 900;
    color: var(--color-text);
  }

  .panel-p {
    margin: 0 0 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-muted);
  }

  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bullet-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    color: var(--color-text);
    font-family: var(--font-body);
  }

  .bullet-list .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-accent-2);
    margin-top: 8px;
    flex: 0 0 auto;
  }

  .callout-box {
    padding: 18px;
    border-radius: 16px;
    border: 1px solid var(--color-stroke);
    background: #ffffff;
  }

  .callout-accent {
    margin-top: 18px;
    background: color-mix(in srgb, var(--color-accent) 8%, #ffffff);
    border-color: var(--color-accent-2);
  }

  .callout-title {
    font-weight: 900;
    font-size: 16px;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .callout-text {
    font-size: 14px;
    line-height: 1.85;
    color: var(--color-muted);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 8px;
  }

  .mission-card {
    padding: 18px;
    border-radius: 16px;
    border: 1px solid var(--color-stroke);
    background: #ffffff;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .card-icon {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    border: 1px solid var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent) 10%, #ffffff);
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 13px;
    color: var(--color-text);
    flex: 0 0 auto;
  }

  .card-h4 {
    margin: 0;
    font-family: var(--font-title);
    font-size: 17px;
    line-height: 1.25;
    font-weight: 900;
    color: var(--color-text);
  }

  .card-p2 {
    margin: 0;
    font-size: 14px;
    line-height: 1.85;
    color: var(--color-muted);
  }

  .acc-box {
    display: grid;
    gap: 14px;
    margin-top: 8px;
  }

  .acc-item {
    border-radius: 16px;
    border: 1px solid var(--color-stroke);
    background: #ffffff;
    overflow: hidden;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .acc-item.is-open {
    border-color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent) 8%, #ffffff);
  }

  .acc-btn {
    width: 100%;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    font-weight: 900;
    font-size: 16px;
    color: var(--color-text);
    font-family: var(--font-body);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .acc-plus {
    font-size: 20px;
    font-weight: 900;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .acc-item.is-open .acc-plus {
    transform: rotate(45deg);
  }

  .acc-panel {
    border-top: 1px solid var(--color-stroke);
  }

  .acc-inner {
    padding: 16px 18px 18px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--color-muted);
  }

  @media (max-width: 980px) {
    .about-details-section {
      padding: 76px 0;
    }

    .about-head {
      margin-bottom: 28px;
    }

    .about-h2 {
      max-width: 100%;
      font-size: clamp(34px, 8vw, 50px);
    }

    .about-sub {
      max-width: 100%;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .about-slider {
      min-height: 340px;
    }

    .about-panels-box {
      min-height: auto;
    }

    .tabbar {
      grid-template-columns: 1fr;
    }

    .panelwrap {
      padding: 20px;
    }

    .mission-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-entering {
      animation: none;
    }
    .about-slider.is-swapping .slide-sweep {
      animation: none;
      opacity: 0;
    }
  }
</style>
