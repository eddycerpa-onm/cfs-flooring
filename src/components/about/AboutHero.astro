---
import { Image } from 'astro:assets';
import aboutHeroImg from '@/assets/about/hero.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section id="about-hero" class:list={['about-hero', className]}>
  <div class="about-hero-inner">
    
    <!-- Left Card: Clean Astro component with agnostic, prefix-free CSS -->
    <div class="about-hero-card" data-motion-stagger="true">
      <div class="about-hero-eyebrow" data-motion="fade-up">
        <div class="about-hero-pill">
          <span>ABOUT CFS FLOORING</span>
        </div>
        <div class="about-hero-subbadge">
          <svg class="about-hero-subbadge-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
          </svg>
          <span class="about-hero-eyebrow-text">Residential • Commercial</span>
        </div>
      </div>

      <h1 class="about-hero-title" data-motion="fade-up">
        Over 10 Years of Flooring Expertise You Can Count On
      </h1>

      <p class="about-hero-lead" data-motion="fade-up">
        At CFS Flooring, we help homeowners and property managers restore beauty, function, and durability with skilled flooring repair, replacement, refinishing, and redesign support. Our team brings hands-on experience, clear communication, and long-lasting results to every project.
      </p>

      <div class="about-hero-chips" aria-label="Core highlights" data-motion="fade-up">
        <span class="about-hero-chip">Trained Professionals</span>
        <span class="about-hero-chip">Long-Lasting Results</span>
        <span class="about-hero-chip">Quality Workmanship</span>
      </div>

      <div class="about-hero-stats" aria-label="Quick highlights" data-motion="fade-up">
        <div class="about-hero-stat">
          <div class="about-hero-stat-kicker">Service Area</div>
          <div class="about-hero-stat-value">Washington & Oregon</div>
        </div>

        <div class="about-hero-stat">
          <div class="about-hero-stat-kicker">Specialty</div>
          <div class="about-hero-stat-value">Repair, Replace & Restore</div>
        </div>

        <div class="about-hero-stat">
          <div class="about-hero-stat-kicker">Focus</div>
          <div class="about-hero-stat-value">Residential & Commercial Floors</div>
        </div>
      </div>

      <div class="about-hero-cta" data-motion="fade-up">
        <a class="btn-primary" href="/contact-us" aria-label="Get a free quote on Contact Us page">
          <span>Get a Quote</span>
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false">
              <path d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </a>

        <a class="btn-secondary" href="/our-services">
          <span>View Services</span>
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>

      <div class="about-hero-note">
        From repairs and partial replacements to full flooring updates, we focus on dependable service, strong craftsmanship, and a smooth process from start to finish.
      </div>
    </div>

    <!-- Right Column Image -->
    <div class="about-hero-media" aria-label="CFS Flooring about image" data-motion="fade-left">
      <Image
        class="about-hero-img"
        src={aboutHeroImg}
        alt="CFS Flooring craftsmanship and team expertise"
        width={720}
        height={540}
        loading="eager"
        decoding="async"
      />

      <div class="about-hero-badge">
        <div class="about-hero-badge-title">Built for lasting results</div>
        <div class="about-hero-badge-sub">Repairs • Replacement • Refinishing • Redesign</div>
      </div>

      <div class="about-hero-floating-stat">
        <span class="about-hero-floating-label">Experience</span>
        <strong class="about-hero-floating-val">10+ Years</strong>
      </div>
    </div>

  </div>
</section>

<style>
  .about-hero {
    background: linear-gradient(180deg, var(--color-bg), var(--color-panel));
    color: var(--color-text);
    padding: 54px 0 64px;
    border-bottom: 1px solid var(--color-stroke);
    position: relative;
    overflow: hidden;
  }

  .about-hero * {
    box-sizing: border-box;
  }

  .about-hero .about-hero-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 clamp(16px, 2vw, 28px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .about-hero .about-hero-inner {
      grid-template-columns: 1.04fr 0.96fr;
    }
  }

  .about-hero .about-hero-card {
    border: 1px solid var(--color-stroke);
    border-radius: 28px;
    background: #ffffff;
    box-shadow: 0 18px 45px rgba(34, 20, 22, 0.08);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 640px;
  }

  .about-hero .about-hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--color-muted);
    font-size: 14px;
    margin-bottom: 14px;
    font-family: var(--font-body);
  }

  .about-hero .about-hero-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--color-panel);
    border: 1px solid var(--color-stroke);
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .about-hero .about-hero-subbadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .about-hero .about-hero-subbadge-icon {
    width: 14px !important;
    height: 14px !important;
    max-width: 14px !important;
    max-height: 14px !important;
    color: var(--color-accent);
    flex-shrink: 0;
    display: inline-block;
  }

  .about-hero .about-hero-eyebrow-text {
    font-weight: 800;
  }

  .about-hero .about-hero-title {
    margin: 0 0 14px;
    font-family: var(--font-title);
    font-size: clamp(38px, 4.4vw, 66px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -1.6px;
    color: var(--color-text);
    max-width: 12ch;
  }

  .about-hero .about-hero-lead {
    margin: 0;
    max-width: 62ch;
    color: var(--color-muted);
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.72;
    font-family: var(--font-body);
  }

  .about-hero .about-hero-chips {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .about-hero .about-hero-chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 12px;
    border-radius: 999px;
    background: var(--color-panel);
    border: 1px solid var(--color-stroke);
    color: var(--color-text);
    font-size: 13px;
    font-weight: 800;
    font-family: var(--font-body);
  }

  .about-hero .about-hero-stats {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--color-stroke);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 640px) {
    .about-hero .about-hero-stats {
      grid-template-columns: 1fr;
    }
  }

  .about-hero .about-hero-stat {
    border: 1px solid var(--color-stroke);
    border-radius: 18px;
    background: var(--color-panel);
    padding: 14px;
  }

  .about-hero .about-hero-stat-kicker {
    margin-bottom: 6px;
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: var(--font-body);
  }

  .about-hero .about-hero-stat-value {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.28;
    color: var(--color-text);
  }

  .about-hero .about-hero-cta {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .about-hero .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    border-radius: 16px;
    padding: 14px 18px;
    transition: transform 0.25s ease, box-shadow 0.35s ease, background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    border: 1px solid var(--color-accent-2);
    white-space: nowrap;
    font-family: var(--font-body);
    background: var(--color-accent-2);
    color: var(--color-dark-bg);
    box-shadow: 0 4px 12px rgba(247, 209, 51, 0.25);
    cursor: pointer;
  }

  .about-hero .btn-primary:hover {
    transform: translateY(-1px);
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .about-hero .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    border-radius: 16px;
    padding: 14px 18px;
    transition: transform 0.25s ease, box-shadow 0.35s ease, background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    border: 1px solid var(--color-stroke);
    white-space: nowrap;
    font-family: var(--font-body);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .about-hero .btn-secondary:hover {
    transform: translateY(-1px);
    background: var(--color-panel);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .about-hero .btn-icon {
    display: inline-flex;
    align-items: center;
  }

  .about-hero .about-hero-note {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--color-stroke);
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .about-hero-media {
    position: relative;
    min-height: 460px;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: var(--color-panel);
    border: 1px solid var(--color-stroke);
  }

  .about-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero-floating-stat {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 10;
    padding: 10px 16px;
    border-radius: 16px;
    background: rgba(34, 20, 22, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-hero-floating-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-body);
  }

  .about-hero-floating-val {
    font-size: 18px;
    font-weight: 900;
    color: var(--color-accent-2);
    font-family: var(--font-title);
  }

  .about-hero-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    z-index: 10;
    padding: 16px;
    border-radius: 16px;
    background: rgba(34, 20, 22, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .about-hero-badge-title {
    font-weight: 700;
    color: #ffffff;
    font-size: 16px;
    font-family: var(--font-title);
  }

  .about-hero-badge-sub {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-body);
  }
</style>
