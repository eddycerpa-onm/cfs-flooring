---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  isDrawer?: boolean;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  isDrawer = false,
  ...rest
} = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center font-bold font-title tracking-wide transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 active:scale-95 disabled:opacity-50 disabled:pointer-events-none rounded-xl';

const variantClasses = {
  primary: 'bg-accent text-white hover:bg-accent/90 shadow-md hover:shadow-lg',
  secondary: 'bg-dark-bg text-white hover:bg-dark-bg/90 shadow-md',
  outline: 'border-2 border-accent text-accent hover:bg-accent hover:text-white',
  ghost: 'text-text hover:bg-panel hover:text-accent',
  accent: 'bg-accent-2 text-dark-bg hover:bg-accent-2/90 font-black shadow-md',
};

const sizeClasses = {
  sm: 'px-4 py-2 text-sm gap-2',
  md: 'px-6 py-3 text-base gap-2',
  lg: 'px-8 py-4 text-lg gap-3',
};

const combinedClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`.trim();
---

{
  href ? (
    <a
      href={href}
      class={combinedClasses}
      {...(isDrawer ? { 'x-on:click.prevent': "$dispatch('open-drawer')" } : {})}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={combinedClasses}
      {...(isDrawer ? { 'x-on:click': "$dispatch('open-drawer')" } : {})}
      {...rest}
    >
      <slot />
    </button>
  )
}
