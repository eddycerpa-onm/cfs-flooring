---
interface Props {
  number?: string | number;
  value?: string | number;
  label?: string;
  kicker?: string;
  subtext?: string;
  dark?: boolean;
  class?: string;
}

const {
  number,
  value,
  label,
  kicker,
  subtext,
  dark = false,
  class: className = '',
} = Astro.props;

const mainNumber = number ?? value ?? '';
const mainLabel = label ?? kicker ?? '';
---

<div
  class:list={[
    'p-6 rounded-2xl transition-all duration-300 border flex flex-col justify-between',
    dark
      ? 'bg-dark-bg/80 border-white/10 text-white shadow-xl backdrop-blur-md'
      : 'bg-panel border-stroke text-text shadow-sm hover:shadow-md hover:border-accent/30',
    className,
  ]}
>
  <div>
    <div class:list={['text-3xl lg:text-4xl font-black font-title tracking-tight mb-1', dark ? 'text-accent-2' : 'text-accent']}>
      {mainNumber}
    </div>
    <div class="text-sm font-bold font-title leading-snug">{mainLabel}</div>
  </div>
  {subtext && <p class:list={['text-xs mt-2 leading-relaxed', dark ? 'text-white/70' : 'text-muted']}>{subtext}</p>}
</div>
