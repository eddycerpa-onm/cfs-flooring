---
interface Props {
  variant?: 'accent' | 'muted' | 'outline' | 'dark' | 'light' | string;
  class?: string;
  [key: string]: any;
}

const { variant = 'accent', class: className = '' } = Astro.props;

const baseClasses =
  'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase font-title transition-colors';

const variantClasses: Record<string, string> = {
  accent: 'bg-accent/10 text-accent border border-accent/20',
  muted: 'bg-panel text-muted border border-stroke',
  outline: 'border border-accent text-accent bg-transparent',
  dark: 'bg-dark-bg text-white border border-white/10',
  light: 'bg-white text-text shadow-sm border border-stroke',
  overlay: 'bg-dark-bg/90 backdrop-blur-md text-accent-2 border border-white/20 shadow-md font-black',
};

const activeVariant = variantClasses[variant] || variantClasses.accent;
const combinedClasses = `${baseClasses} ${activeVariant} ${className}`.trim();
---

<span class={combinedClasses}>
  <slot />
</span>
