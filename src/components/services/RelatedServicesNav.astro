---
import { Image } from 'astro:assets';
import { getRelatedServices, type ServiceItem } from '@/data/services';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const relatedServices: ServiceItem[] = getRelatedServices(currentSlug, 3);
---

<section class="py-16 lg:py-24 bg-bg border-b border-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-accent font-title mb-2">
          Explore Other Solutions
        </span>
        <h2 class="text-3xl font-extrabold font-title text-text tracking-tight">
          More Flooring Services
        </h2>
      </div>
      <a
        href="/our-services"
        class="inline-flex items-center gap-2 text-sm font-bold font-title text-accent hover:text-accent-2 transition-colors"
      >
        <span>View All Services</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {relatedServices.map((service) => (
        <article class="p-6 rounded-3xl bg-panel border border-stroke shadow-sm hover:border-accent hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="rounded-2xl overflow-hidden mb-6 border border-stroke aspect-[4/3]">
              <Image
                src={service.image}
                alt={service.title}
                width={400}
                height={300}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h3 class="text-xl font-bold font-title text-text mb-3 leading-tight group-hover:text-accent transition-colors">
              {service.title}
            </h3>
            <p class="text-sm text-muted leading-relaxed mb-6">
              {service.cardDescription}
            </p>
          </div>

          <a
            href={`/services/${service.slug}`}
            class="inline-flex items-center justify-between w-full py-3 px-4 rounded-xl bg-bg border border-stroke text-sm font-bold font-title text-text group-hover:bg-accent group-hover:text-white group-hover:border-accent transition-colors"
          >
            <span>Learn More</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
