---
import { Image } from 'astro:assets';
import { company } from '@/data/company';
import { serviceSublinks } from '@/data/navigation';
import logo from '@/assets/logo.svg';
---

<header id="siteHeader" class="sticky top-0 z-50 w-full bg-bg border-b border-stroke site-header-shadow transition-transform duration-300 ease-in-out">
  <div class="cfs-base-container h-header flex items-center justify-between">
    
    <!-- Brand Logo (Responsive 54px mobile -> 58px tablet -> 82px desktop) -->
    <a href="/" class="shrink-0 flex items-center pl-1 sm:pl-2">
      <Image src={logo} alt={company.name} class="h-[54px] sm:h-[58px] lg:h-[82px] w-auto object-contain transition-all duration-300" />
    </a>

    <!-- Desktop Nav Links (Font: Lexend Deca 700, 16px, Animated underline) -->
    <nav class="hidden md:flex items-center gap-2" x-data="{ servicesOpen: false }">
      <a
        href="/"
        class="nav-link-anim px-nav-px pt-nav-pt pb-nav-pb rounded-nav text-base font-title text-text tracking-nav"
      >
        Home
      </a>

      <a
        href="/about-us"
        class="nav-link-anim px-nav-px pt-nav-pt pb-nav-pb rounded-nav text-base font-title text-text tracking-nav"
      >
        About
      </a>

      <!-- Services Dropdown -->
      <div class="relative" @mouseenter="servicesOpen = true" @mouseleave="servicesOpen = false">
        <a
          href="/our-services"
          class="nav-link-anim inline-flex items-center gap-2 px-nav-px pt-nav-pt pb-nav-pb rounded-nav text-base font-title text-text tracking-nav"
        >
          <span>Services</span>
          <svg class="w-4 h-4 transition-transform duration-300" :class="{ 'rotate-180': servicesOpen }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div
          x-show="servicesOpen"
          x-cloak
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute left-0 top-full mt-1.5 w-dropdown p-2.5 rounded-dropdown bg-panel border border-stroke shadow-xl grid gap-1.5 z-50"
        >
          {serviceSublinks.map((s) => (
            <a
              href={s.href}
              class="px-3.5 py-3 rounded-nav text-sm font-bold text-text hover:bg-bg hover:border-stroke hover:text-accent transition-all transform hover:translate-x-0.5 border border-transparent"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <a
        href="/contact-us"
        class="nav-link-anim px-nav-px pt-nav-pt pb-nav-pb rounded-nav text-base font-title text-text tracking-nav"
      >
        Contact Us
      </a>
    </nav>

    <!-- Header Actions & Mobile Nav Trigger -->
    <div class="flex items-center gap-2 sm:gap-3" x-data="{ mobileMenuOpen: false }">
      <!-- Desktop Social Circles -->
      <div class="hidden lg:flex items-center gap-2">
        <a
          href="https://www.facebook.com/people/CFS-Flooring/61558449837319/"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link-header"
          aria-label="Facebook"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M13.5 22v-8h2.7l.8-3h-3.5V9.1c0-.9.3-1.6 1.7-1.6H17V4.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.6-4.6 4.6V11H7v3h2.7v8h3.8Z"></path>
          </svg>
        </a>

        <a
          href="https://www.instagram.com/cfsflooring/"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link-header"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M7.75 2h8.5C19.43 2 22 4.57 22 7.75v8.5C22 19.43 19.43 22 16.25 22h-8.5C4.57 22 2 19.43 2 16.25v-8.5C2 4.57 4.57 2 7.75 2Zm0 2C5.68 4 4 5.68 4 7.75v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 4 16.25 4h-8.5Zm9.75 2.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"></path>
          </svg>
        </a>

        <a
          href="https://www.google.com/search?q=CFS+Flooring"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link-header"
          aria-label="Google Business Location"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path>
          </svg>
        </a>
      </div>

      <!-- Call Us Now Button (Always Visible) -->
      <a
        href={`tel:${company.phoneRaw}`}
        class="btn-yellow-dark !py-2.5 !px-3 sm:!px-5 text-xs sm:text-sm shrink-0"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="shrink-0">
          <path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1.5 1.5 0 0 1 1.5-.37c1.17.39 2.42.6 3.72.6A1.35 1.35 0 0 1 22 16.8V21a1 1 0 0 1-1 1C10.5 22 2 13.5 2 3a1 1 0 0 1 1-1h4.2a1.35 1.35 0 0 1 1.35 1.35c0 1.3.21 2.55.6 3.72a1.5 1.5 0 0 1-.37 1.5l-2.18 2.23Z"></path>
        </svg>
        <span class="whitespace-nowrap">Call Us Now</span>
      </a>

      <!-- Mobile Hamburger Button (Visible md:hidden) -->
      <button
        type="button"
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="md:hidden w-11 h-11 rounded-2xl bg-bg border border-stroke flex flex-col items-center justify-center gap-1 shrink-0 cursor-pointer hover:border-accent transition-colors"
        aria-label="Toggle Navigation Menu"
      >
        <span class="w-5 h-0.5 bg-text rounded-full transition-transform" :class="{ 'rotate-45 translate-y-1.5': mobileMenuOpen }"></span>
        <span class="w-5 h-0.5 bg-text rounded-full transition-opacity" :class="{ 'opacity-0': mobileMenuOpen }"></span>
        <span class="w-5 h-0.5 bg-text rounded-full transition-transform" :class="{ '-rotate-45 -translate-y-1.5': mobileMenuOpen }"></span>
      </button>

      <!-- Mobile Dropdown Menu -->
      <div
        x-show="mobileMenuOpen"
        x-cloak
        @click.outside="mobileMenuOpen = false"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="md:hidden absolute top-full left-0 right-0 bg-bg border-b border-stroke shadow-2xl p-4 flex flex-col gap-3 z-50"
      >
        <a href="/" class="px-4 py-3 rounded-xl bg-panel text-sm font-bold text-text hover:text-accent border border-stroke">Home</a>
        <a href="/about-us" class="px-4 py-3 rounded-xl bg-panel text-sm font-bold text-text hover:text-accent border border-stroke">About</a>
        <a href="/our-services" class="px-4 py-3 rounded-xl bg-panel text-sm font-bold text-text hover:text-accent border border-stroke">Services</a>
        <a href="/contact-us" class="px-4 py-3 rounded-xl bg-panel text-sm font-bold text-text hover:text-accent border border-stroke">Contact Us</a>
        
        <div class="flex items-center gap-3 pt-2 border-t border-stroke justify-center">
          <a href="https://www.facebook.com/people/CFS-Flooring/61558449837319/" target="_blank" rel="noopener noreferrer" class="social-link-header" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M13.5 22v-8h2.7l.8-3h-3.5V9.1c0-.9.3-1.6 1.7-1.6H17V4.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.6-4.6 4.6V11H7v3h2.7v8h3.8Z"></path>
            </svg>
          </a>
          <a href="https://www.instagram.com/cfsflooring/" target="_blank" rel="noopener noreferrer" class="social-link-header" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M7.75 2h8.5C19.43 2 22 4.57 22 7.75v8.5C22 19.43 19.43 22 16.25 22h-8.5C4.57 22 2 19.43 2 16.25v-8.5C2 4.57 4.57 2 7.75 2Zm0 2C5.68 4 4 5.68 4 7.75v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 4 16.25 4h-8.5Zm9.75 2.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"></path>
            </svg>
          </a>
          <a href="https://www.google.com/search?q=CFS+Flooring" target="_blank" rel="noopener noreferrer" class="social-link-header" aria-label="Google Business Location">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

  </div>
</header>

<script>
  function initHeaderScroll() {
    const header = document.getElementById("siteHeader");
    if (!header) return;

    let lastScrollY = window.scrollY;

    window.addEventListener("scroll", () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY > lastScrollY && currentScrollY > 100) {
        header.classList.add("-translate-y-full");
      } else {
        header.classList.remove("-translate-y-full");
      }

      lastScrollY = currentScrollY;
    }, { passive: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderScroll);
  } else {
    initHeaderScroll();
  }
</script>
