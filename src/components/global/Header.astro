---
import { Image } from 'astro:assets';
import { company } from '@/data/company';
import { serviceSublinks } from '@/data/navigation';
import logo from '@/assets/logo.svg';
---

<header id="mainHeader" class="sticky top-0 z-[1000] w-full bg-bg border-b border-stroke shadow-[0_18px_45px_rgba(34,20,22,0.12)] transition-transform duration-300 ease-in-out">
  <div class="max-w-[1280px] mx-auto p-[12px] min-[521px]:px-4 min-[769px]:px-[22px] min-[769px]:py-[18px] flex items-center justify-between gap-3 min-[769px]:gap-6">
    
    <!-- Logo Brand -->
    <a href="/" class="shrink-0 flex items-center pl-[6px] min-[769px]:pl-0" aria-label="CFS Flooring Home">
      <Image
        src={logo}
        alt={company.name}
        loading="eager"
        decoding="async"
        class="h-[54px] min-[521px]:h-[58px] min-[769px]:h-[82px] w-auto object-contain transition-all duration-300"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden min-[769px]:flex items-center gap-1 min-[1200px]:gap-2" aria-label="Primary navigation">
      <ul class="flex items-center gap-1 min-[1200px]:gap-2 m-0 p-0 list-none" role="list">
        <li>
          <a href="/" class="relative px-3 min-[1200px]:px-[18px] pt-[14px] pb-[18px] rounded-[14px] text-base font-bold font-title text-text tracking-[-0.16px] hover:text-accent hover:bg-panel transition-all duration-300 after:content-[''] after:absolute after:left-[18px] after:right-[18px] after:bottom-[8px] after:h-[2px] after:bg-accent after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-300">
            Home
          </a>
        </li>
        <li>
          <a href="/about-us" class="relative px-3 min-[1200px]:px-[18px] pt-[14px] pb-[18px] rounded-[14px] text-base font-bold font-title text-text tracking-[-0.16px] hover:text-accent hover:bg-panel transition-all duration-300 after:content-[''] after:absolute after:left-[18px] after:right-[18px] after:bottom-[8px] after:h-[2px] after:bg-accent after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-300">
            About
          </a>
        </li>

        <!-- Services Dropdown -->
        <li class="relative group" x-data="{ servicesOpen: false }" @mouseenter="servicesOpen = true" @mouseleave="servicesOpen = false">
          <a href="/our-services" class="relative inline-flex items-center gap-1.5 min-[1200px]:gap-2 px-3 min-[1200px]:px-[18px] pt-[14px] pb-[18px] rounded-[14px] text-base font-bold font-title text-text tracking-[-0.16px] hover:text-accent hover:bg-panel transition-all duration-300 after:content-[''] after:absolute after:left-[18px] after:right-[18px] after:bottom-[8px] after:h-[2px] after:bg-accent after:scale-x-0 group-hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-300">
            <span>Services</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" :class="{ 'rotate-180': servicesOpen }" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M6.7 9.3a1 1 0 0 1 1.4 0L12 13.2l3.9-3.9a1 1 0 1 1 1.4 1.4l-4.6 4.6a1 1 0 0 1-1.4 0L6.7 10.7a1 1 0 0 1 0-1.4Z"/>
            </svg>
          </a>

          <!-- Hover Bridge -->
          <div class="absolute left-0 right-0 top-full h-4"></div>

          <!-- Dropdown Card -->
          <div role="menu" aria-label="Services Submenu" class="absolute left-0 top-[calc(100%+6px)] min-w-[300px] p-[10px] rounded-[18px] bg-panel border border-stroke shadow-[0_18px_45px_rgba(34,20,22,0.12)] grid gap-[6px] opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto translate-y-2 group-hover:translate-y-0 transition-all duration-200 z-[1200]" :class="{ '!opacity-100 !visible !pointer-events-auto !translate-y-0': servicesOpen }">
            {serviceSublinks.map((s) => (
              <a href={s.href} role="menuitem" aria-label={s.label} class="p-[12px_14px] rounded-[14px] text-sm font-bold text-text hover:bg-bg hover:border-stroke hover:text-accent border border-transparent transition-all hover:translate-x-1">
                {s.label}
              </a>
            ))}
          </div>
        </li>

        <li>
          <a href="/blog" class="relative px-3 min-[1200px]:px-[18px] pt-[14px] pb-[18px] rounded-[14px] text-base font-bold font-title text-text tracking-[-0.16px] hover:text-accent hover:bg-panel transition-all duration-300 after:content-[''] after:absolute after:left-[18px] after:right-[18px] after:bottom-[8px] after:h-[2px] after:bg-accent after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-300">
            Blog
          </a>
        </li>
        <li>
          <a href="/contact-us" class="relative px-3 min-[1200px]:px-[18px] pt-[14px] pb-[18px] rounded-[14px] text-base font-bold font-title text-text tracking-[-0.16px] hover:text-accent hover:bg-panel transition-all duration-300 after:content-[''] after:absolute after:left-[18px] after:right-[18px] after:bottom-[8px] after:h-[2px] after:bg-accent after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-300">
            Contact Us
          </a>
        </li>
      </ul>
    </nav>

    <!-- Navigation Actions (Social Circles + Call Button + Hamburger) -->
    <div 
      class="flex items-center gap-[8px] min-[769px]:gap-[10px] shrink-0 ml-auto min-[769px]:ml-0" 
      x-data="{ mobileMenuOpen: false }"
      x-init="$watch('mobileMenuOpen', value => {
        const header = document.getElementById('mainHeader');
        if (value) {
          if (header) header.classList.remove('-translate-y-full');
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      })"
    >
      
      <!-- Desktop Social Links -->
      <div class="hidden min-[769px]:flex items-center gap-1.5 min-[1200px]:gap-2">
        <a href="https://www.facebook.com/people/CFS-Flooring/61558449837319/" target="_blank" rel="noopener noreferrer" class="w-[40px] h-[40px] grid place-items-center rounded-[14px] border border-stroke bg-panel text-text hover:bg-accent hover:text-white hover:border-accent hover:-translate-y-0.5 transition-all duration-300 shadow-[0_18px_45px_rgba(34,20,22,0.12)]" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 22v-8h2.7l.8-3h-3.5V9.1c0-.9.3-1.6 1.7-1.6H17V4.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.6-4.6 4.6V11H7v3h2.7v8h3.8Z"/></svg>
        </a>
        <a href="https://www.instagram.com/cfsflooring/" target="_blank" rel="noopener noreferrer" class="w-[40px] h-[40px] grid place-items-center rounded-[14px] border border-stroke bg-panel text-text hover:bg-accent hover:text-white hover:border-accent hover:-translate-y-0.5 transition-all duration-300 shadow-[0_18px_45px_rgba(34,20,22,0.12)]" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7.75 2h8.5C19.43 2 22 4.57 22 7.75v8.5C22 19.43 19.43 22 16.25 22h-8.5C4.57 22 2 19.43 2 16.25v-8.5C2 4.57 4.57 2 7.75 2Zm0 2C5.68 4 4 5.68 4 7.75v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 4 16.25 4h-8.5Zm9.75 2.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
        </a>
        <a href="https://www.google.com/search?q=CFS+Flooring" target="_blank" rel="noopener noreferrer" class="w-[40px] h-[40px] grid place-items-center rounded-[14px] border border-stroke bg-panel text-text hover:bg-accent hover:text-white hover:border-accent hover:-translate-y-0.5 transition-all duration-300 shadow-[0_18px_45px_rgba(34,20,22,0.12)]" aria-label="Google Business">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
        </a>
      </div>

      <!-- Call Us Now Button -->
      <a href={`tel:${company.phoneRaw}`} class="inline-flex items-center justify-center gap-[6px] min-[521px]:gap-[8px] min-[769px]:gap-[10px] py-[10px] px-[12px] min-[521px]:py-[12px] min-[521px]:px-[16px] min-[1200px]:px-[22px] rounded-[16px] bg-accent-2 text-dark-bg hover:bg-dark-bg hover:text-white border border-accent-2 hover:border-dark-bg text-[14px] min-[521px]:text-[15px] min-[769px]:text-[16px] font-black font-body tracking-[0.3px] transition-all duration-300 shadow-[0_18px_45px_rgba(34,20,22,0.12)] hover:-translate-y-[2px] shrink-0" aria-label={`Call us now at ${company.phone}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="w-[17px] min-[769px]:w-[18px] h-[17px] min-[769px]:h-[18px] shrink-0" aria-hidden="true" focusable="false">
          <path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1.5 1.5 0 0 1 1.5-.37c1.17.39 2.42.6 3.72.6A1.35 1.35 0 0 1 22 16.8V21a1 1 0 1 1-1 1C10.5 22 2 13.5 2 3a1 1 0 0 1 1-1h4.2a1.35 1.35 0 0 1 1.35 1.35c0 1.3.21 2.55.6 3.72a1.5 1.5 0 0 1-.37 1.5l-2.18 2.23Z"/>
        </svg>
        <span class="whitespace-nowrap">Call Us Now</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="min-[769px]:hidden w-[46px] h-[46px] rounded-[16px] bg-bg border border-stroke flex flex-col items-center justify-center gap-[5px] shrink-0 cursor-pointer hover:border-accent transition-all duration-300"
        aria-label="Toggle Navigation Menu"
      >
        <span class="w-[20px] h-[2px] bg-text rounded-full transition-all duration-300" :class="{ 'rotate-45 translate-y-[7px]': mobileMenuOpen }"></span>
        <span class="w-[20px] h-[2px] bg-text rounded-full transition-all duration-300" :class="{ 'opacity-0': mobileMenuOpen }"></span>
        <span class="w-[20px] h-[2px] bg-text rounded-full transition-all duration-300" :class="{ '-rotate-45 -translate-y-[7px]': mobileMenuOpen }"></span>
      </button>

      <!-- Mobile Menu Drawer -->
      <div
        x-show="mobileMenuOpen"
        x-cloak
        @click.outside="mobileMenuOpen = false"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2 blur-[8px]"
        x-transition:enter-end="opacity-100 translate-y-0 blur-none"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0 blur-none"
        x-transition:leave-end="opacity-0 -translate-y-2 blur-[8px]"
        class="min-[769px]:hidden fixed top-[78px] min-[521px]:top-[82px] left-0 right-0 bottom-0 bg-bg border-t border-stroke shadow-2xl z-[2000] overflow-hidden flex flex-col justify-between"
      >
        <!-- Scrollable Links Container -->
        <div class="w-full max-w-[1280px] mx-auto flex-1 overflow-y-auto p-5 pb-6 flex flex-col gap-3" data-motion-stagger="true">
          <a data-motion="fade-right" href="/" class="w-full block p-[14px_16px] rounded-[16px] bg-panel text-base font-bold text-text hover:text-accent hover:border-accent border border-stroke transition-colors">Home</a>
          <a data-motion="fade-right" href="/about-us" class="w-full block p-[14px_16px] rounded-[16px] bg-panel text-base font-bold text-text hover:text-accent hover:border-accent border border-stroke transition-colors">About</a>

          <!-- Mobile Services Accordion -->
          <div data-motion="fade-right" x-data="{ openMobileServices: false }" class="w-full flex flex-col gap-2">
            <button
              type="button"
              @click="openMobileServices = !openMobileServices"
              aria-label="Toggle Mobile Services Menu"
              class="w-full p-[14px_16px] rounded-[16px] bg-panel text-base font-bold text-text flex items-center justify-between border border-stroke cursor-pointer hover:text-accent hover:border-accent transition-colors"
            >
              <span>Services</span>
              <svg class="w-4 h-4 transition-transform duration-300" :class="{ 'rotate-180': openMobileServices }" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M6.7 9.3a1 1 0 0 1 1.4 0L12 13.2l3.9-3.9a1 1 0 1 1 1.4 1.4l-4.6 4.6a1 1 0 0 1-1.4 0L6.7 10.7a1 1 0 0 1 0-1.4Z"/>
              </svg>
            </button>

            <div x-show="openMobileServices" x-cloak role="menu" aria-label="Mobile Services Submenu" class="w-full ml-3 flex flex-col gap-2 pt-1 pb-1">
              {serviceSublinks.map((s) => (
                <a href={s.href} role="menuitem" aria-label={s.label} class="w-full block p-[12px_14px] rounded-[14px] text-sm font-bold text-text hover:text-accent bg-bg border border-stroke hover:translate-x-1 transition-transform">
                  {s.label}
                </a>
              ))}
            </div>
          </div>

          <a data-motion="fade-right" href="/blog" class="w-full block p-[14px_16px] rounded-[16px] bg-panel text-base font-bold text-text hover:text-accent hover:border-accent border border-stroke transition-colors">Blog</a>
          <a data-motion="fade-right" href="/contact-us" class="w-full block p-[14px_16px] rounded-[16px] bg-panel text-base font-bold text-text hover:text-accent hover:border-accent border border-stroke transition-colors">Contact Us</a>
        </div>

        <!-- Fixed Bottom Social Links Footer -->
        <div data-motion="fade-up" class="w-full shrink-0 bg-bg border-t border-stroke shadow-[0_-8px_20px_rgba(0,0,0,0.04)]">
          <div class="max-w-[1280px] mx-auto px-5 py-[8px] flex items-center justify-center gap-4" data-motion-stagger="true">
            <a data-motion="fade-up" href="https://www.facebook.com/people/CFS-Flooring/61558449837319/" target="_blank" rel="noopener noreferrer" class="w-[46px] h-[46px] grid place-items-center rounded-[16px] border border-stroke bg-panel text-text hover:bg-accent hover:text-white transition-colors shadow-sm" aria-label="Facebook">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 22v-8h2.7l.8-3h-3.5V9.1c0-.9.3-1.6 1.7-1.6H17V4.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.6-4.6 4.6V11H7v3h2.7v8h3.8Z"/></svg>
            </a>
            <a data-motion="fade-up" href="https://www.instagram.com/cfsflooring/" target="_blank" rel="noopener noreferrer" class="w-[46px] h-[46px] grid place-items-center rounded-[16px] border border-stroke bg-panel text-text hover:bg-accent hover:text-white transition-colors shadow-sm" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7.75 2h8.5C19.43 2 22 4.57 22 7.75v8.5C22 19.43 19.43 22 16.25 22h-8.5C4.57 22 2 19.43 2 16.25v-8.5C2 4.57 4.57 2 7.75 2Zm0 2C5.68 4 4 5.68 4 7.75v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 4 16.25 4h-8.5Zm9.75 2.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
            </a>
            <a data-motion="fade-up" href="https://www.google.com/search?q=CFS+Flooring" target="_blank" rel="noopener noreferrer" class="w-[46px] h-[46px] grid place-items-center rounded-[16px] border border-stroke bg-panel text-text hover:bg-accent hover:text-white transition-colors shadow-sm" aria-label="Google Business">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function initHeaderScroll() {
    const header = document.getElementById('mainHeader');
    if (!header) return;

    let lastScrollY = window.scrollY;

    window.addEventListener('scroll', () => {
      // Check if mobile menu is open - if open, do not execute scroll hide logic!
      const actionDiv = header.querySelector('[x-data]') as any;
      if (actionDiv && actionDiv._x_dataStack && actionDiv._x_dataStack[0] && actionDiv._x_dataStack[0].mobileMenuOpen) {
        return;
      }

      const currentScrollY = window.scrollY;
      if (currentScrollY > lastScrollY && currentScrollY > 90) {
        // Scroll Down -> Hide Header
        header.classList.add('-translate-y-full');
      } else {
        // Scroll Up -> Show Header
        header.classList.remove('-translate-y-full');
      }
      lastScrollY = currentScrollY;
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderScroll);
  } else {
    initHeaderScroll();
  }
</script>

