---
import { SEO } from 'astro-seo';
import { company } from '../../data/company';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = `${company.name} | Flooring & Painting in Lake Oswego, West Linn & Portland Metro`,
  description = company.description,
  image = '/og-image.png',
  canonical = Astro.url.href,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteName = company.name;
const fullImageUrl = new URL(image, Astro.site || 'https://cfsflooring.com').href;
const fullLogoUrl = new URL('/favicon.svg', Astro.site || 'https://cfsflooring.com').href;
---

<SEO
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  openGraph={{
    basic: {
      title,
      type,
      image: fullImageUrl,
      url: canonical,
    },
    optional: {
      siteName,
      description,
      locale: 'en_US',
    },
    image: {
      alt: title,
      type: 'image/png',
      width: 1200,
      height: 630,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    site: '@cfsflooring',
    title,
    description,
    image: fullImageUrl,
    imageAlt: title,
  }}
/>

<meta property="og:image:secure_url" content={fullImageUrl} />
<meta property="og:logo" content={fullLogoUrl} />

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Google Fonts Official Variable Suite (100..1000) matching cfsflooring.com -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Lexend+Deca:wght@100..900&display=swap" rel="stylesheet">
