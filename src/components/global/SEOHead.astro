---
import { SEO } from 'astro-seo';
import { company } from '../../data/company';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = `${company.name} | Flooring & Painting in Lake Oswego, West Linn & Portland Metro`,
  description = company.description,
  image = '/og-image.png',
  canonical = Astro.url.href,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteName = company.name;
const fullImageUrl = new URL(image, Astro.site || 'https://cfsflooring.com').href;
const fullLogoUrl = new URL('/favicon.svg', Astro.site || 'https://cfsflooring.com').href;
---

<SEO
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  openGraph={{
    basic: {
      title,
      type,
      image: fullImageUrl,
      url: canonical,
    },
    optional: {
      siteName,
      description,
      locale: 'en_US',
    },
    image: {
      alt: title,
      type: 'image/png',
      width: 1200,
      height: 630,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    site: '@cfsflooring',
    title,
    description,
    image: fullImageUrl,
    imageAlt: title,
  }}
/>

<meta property="og:image:secure_url" content={fullImageUrl} />
<meta property="og:logo" content={fullLogoUrl} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Local Fonts Preload for Maximum Performance -->
<link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/lexend-deca-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />

