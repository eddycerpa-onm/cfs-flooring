---
import { Image } from 'astro:assets';
import { company } from '@/data/company';
import { navigationData, serviceSublinks, legalLinks } from '@/data/navigation';
import logo from '@/assets/logo.svg';

const socialLinks = [
  {
    platform: 'Facebook',
    url: 'https://www.facebook.com/profile.php?id=61558449837319',
    svg: 'M13.5 22v-8h2.7l.8-3h-3.5V9.1c0-.9.3-1.6 1.7-1.6H17V4.8c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.6-4.6 4.6V11H7v3h2.7v8h3.8Z',
  },
  {
    platform: 'Instagram',
    url: 'https://www.instagram.com/cfsflooring/?igsh=YTQwZjQ0NmI0OA%3D%3D&utm_source=qr',
    svg: 'M7.75 2h8.5C19.43 2 22 4.57 22 7.75v8.5C22 19.43 19.43 22 16.25 22h-8.5C4.57 22 2 19.43 2 16.25v-8.5C2 4.57 4.57 2 7.75 2Zm0 2C5.68 4 4 5.68 4 7.75v8.5C4 18.32 5.68 20 7.75 20h8.5c2.07 0 3.75-1.68 3.75-3.75v-8.5C20 5.68 18.32 4 16.25 4h-8.5Zm9.75 2.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  },
  {
    platform: 'Google Business',
    url: 'https://www.google.com/search?q=CFS+Flooring',
    svg: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z',
  },
];
---

<footer class="bg-bg text-text border-t border-stroke font-body" id="footer">
  <div class="max-w-[1500px] mx-auto px-[22px] pt-[34px] sm:pt-[48px] pb-[18px]">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.2fr_0.9fr_0.95fr_1.2fr] gap-[18px] items-start">
      
      <!-- Col 1: Brand Logo & Desc -->
      <div class="flex flex-col" data-motion="fade-right">
        <a href="/" class="inline-flex items-center mb-[14px]" aria-label="Home">
          <Image src={logo} alt={company.name} width={240} height={78} class="h-[78px] w-auto object-contain" loading="lazy" decoding="async" />
        </a>
        <p class="text-[14px] text-muted leading-[1.65] font-body max-w-[58ch] m-0">
          Quality flooring installation with honest guidance you can trust. CFS Flooring serves homes and businesses across Lake Oswego, West Linn, and Wilsonville with a focus on craftsmanship, transparency, and clean results.
        </p>
      </div>

      <!-- Col 2: Menu Links -->
      <nav class="flex flex-col" aria-label="Footer menu" data-motion-stagger="true">
        <h3 class="text-[14px] font-black font-title text-text mt-[6px] mb-[12px]" data-motion="fade-up">
          Menu
        </h3>
        <ul class="flex flex-col gap-[8px] list-none p-0 m-0" role="list">
          {navigationData.quickLinks.map((link) => (
            <li data-motion="fade-up">
              <a
                href={link.href}
                class="inline-flex items-center h-[40px] px-[12px] rounded-[14px] border border-stroke bg-panel text-[14px] font-bold text-text hover:text-accent hover:border-accent transition-all w-fit max-[980px]:w-full max-[980px]:justify-between"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Col 3: Services Links -->
      <nav class="flex flex-col" aria-label="Footer services" data-motion-stagger="true">
        <h3 class="text-[14px] font-black font-title text-text mt-[6px] mb-[12px]" data-motion="fade-up">
          Services
        </h3>
        <ul class="flex flex-col gap-[8px] list-none p-0 m-0" role="list">
          {serviceSublinks.map((service) => (
            <li data-motion="fade-up">
              <a
                href={service.href}
                class="inline-flex items-center h-[40px] px-[12px] rounded-[14px] border border-stroke bg-panel text-[14px] font-bold text-text hover:text-accent hover:border-accent transition-all w-fit max-[980px]:w-full max-[980px]:justify-between"
              >
                {service.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Col 4: Contact Card & Social -->
      <div class="flex flex-col" data-motion="fade-left">
        <h3 class="text-[14px] font-black font-title text-text mt-[6px] mb-[12px]">
          Contact
        </h3>

        <div class="rounded-[16px] border border-stroke bg-panel shadow-sm overflow-hidden mb-[14px]">
          <!-- Service Areas -->
          <div class="flex gap-[12px] p-[13px_12px] border-b border-stroke">
            <div class="w-[38px] h-[38px] rounded-[14px] border border-stroke bg-bg flex items-center justify-center text-accent flex-shrink-0" aria-hidden="true">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/>
              </svg>
            </div>
            <div>
              <div class="text-[12px] font-black text-muted mb-[2px]">Service Areas</div>
              <div class="text-[14px] font-bold text-text leading-[1.4]">
                Lake Oswego, West Linn, Wilsonville & Vancouver.
              </div>
            </div>
          </div>

          <!-- Phone -->
          <a href={`tel:${company.phoneRaw}`} class="flex items-center gap-[12px] p-[13px_12px] border-b border-stroke text-text hover:text-accent transition-colors" aria-label={`Call CFS Flooring at ${company.phone}`}>
            <div class="w-[38px] h-[38px] rounded-[14px] border border-stroke bg-bg flex items-center justify-center text-accent flex-shrink-0" aria-hidden="true">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.07 21 3 13.93 3 5c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/>
              </svg>
            </div>
            <div>
              <div class="text-[12px] font-black text-muted mb-[2px]">Phone</div>
              <div class="text-[14px] font-bold text-text leading-[1.4]">{company.phone}</div>
            </div>
          </a>

          <!-- Email -->
          <a href={`mailto:${company.email}`} class="flex items-center gap-[12px] p-[13px_12px] text-text hover:text-accent transition-colors" aria-label="Email CFS Flooring">
            <div class="w-[38px] h-[38px] rounded-[14px] border border-stroke bg-bg flex items-center justify-center text-accent flex-shrink-0" aria-hidden="true">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.24-8 5-8-5V6l8 5 8-5v2.24Z"/>
              </svg>
            </div>
            <div>
              <div class="text-[12px] font-black text-muted mb-[2px]">Email</div>
              <div class="text-[14px] font-bold text-text leading-[1.4]">{company.email}</div>
            </div>
          </a>
        </div>

        <!-- Social Icons SVG -->
        <div class="flex items-center gap-[10px]" aria-label="Social links">
          {socialLinks.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-[36px] h-[36px] rounded-[14px] border border-stroke bg-bg flex items-center justify-center text-accent hover:bg-accent hover:text-white transition-colors"
              aria-label={s.platform}
            >
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={s.svg} />
              </svg>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="mt-[18px] pt-[14px] border-t border-stroke flex flex-wrap items-center justify-between gap-[10px]" data-motion="fade-up">
      <p class="m-0 text-[13px] font-extrabold text-muted">
        © {new Date().getFullYear()} {company.legalName}. All rights reserved.
      </p>
      <div class="flex items-center gap-[10px] flex-wrap" aria-label="Legal links">
        {legalLinks.map((link, index) => (
          <>
            {index > 0 && <span class="text-muted font-bold" aria-hidden="true">•</span>}
            <a
              href={link.href}
              class="text-[14px] font-black text-text px-[10px] py-[6px] rounded-[12px] hover:text-accent transition-colors"
            >
              {link.label}
            </a>
          </>
        ))}
      </div>
    </div>
  </div>
</footer>
