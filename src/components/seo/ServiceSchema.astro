---
import { company } from '../../data/company';

interface Props {
  name: string;
  description: string;
  slug?: string;
  url?: string;
}

const { name, description, slug, url } = Astro.props;
const targetUrl = url || `https://cfsflooring.com/services/${slug || ''}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  name: name,
  description: description,
  url: targetUrl,
  image: 'https://cfsflooring.com/og-image.png',
  brand: {
    '@type': 'Brand',
    name: company.name,
    logo: 'https://cfsflooring.com/favicon.svg',
  },
  provider: {
    '@type': 'HomeAndConstructionBusiness',
    name: company.name,
    telephone: company.phoneRaw,
    email: company.email,
    url: 'https://cfsflooring.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free on-site flooring estimate and project consultation',
    availability: 'https://schema.org/InStock',
    url: 'https://cfsflooring.com/contact-us',
  },
  areaServed: company.serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a.city}, ${a.state}`,
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
