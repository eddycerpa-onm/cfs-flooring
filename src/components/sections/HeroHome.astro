---
import { company } from '@/data/company';
import heroPoster from '@/assets/hero-poster.webp';

const chips = [
	'Hardwood, Laminate & LVP',
	'Carpet Installation',
	'Sand & Finish',
	'Flooring Removal',
];
---

<section class="home-banner-section cfs-flooring-hero">
	<div class="cfs-right-bg-banner">
		<div class="cfs-media-frame">
			<video
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				poster={heroPoster.src}
				class="cfs-banner-video"
			>
				<source src="/videos/hero.mp4" type="video/mp4" />
			</video>
			<div class="cfs-media-overlay"></div>
		</div>
	</div>

	<div class="cfs-base-container">
		<div class="cfs-banner-wrapper">
			<div class="cfs-banner-left">
				<div class="cfs-title-wrapper">
					<div class="cfs-eyebrow">
						{company.name} LLC
					</div>

					<h1 class="cfs-hero-h1">
						Quality flooring installation
						<span class="cfs-overlap-text-h1">
							with honest guidance you can trust
						</span>
					</h1>

					<p class="cfs-banner-desc">
						Professional flooring installation for homes and businesses in Lake
						Oswego, West Linn, Wilsonville and Vancouver. With over 10 years of
						experience, Jose helps clients choose the right flooring for their
						space, budget, and long-term goals.
					</p>
				</div>

				<div class="cfs-buttons-wrapper">
					<div class="cfs-left-button-banner">
						<div class="cfs-badge">
							<div class="cfs-badge-top">10+ Years Experience</div>
							<div class="cfs-badge-bottom">
								Quality craftsmanship with personal service
							</div>
						</div>
					</div>

					<button
						type="button"
						@click="$dispatch('open-drawer')"
						class="btn-yellow-accent cfs-primary-button cfs-banner-large"
					>
						<span>Get a Quote</span>
						<span class="cfs-btn-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none">
								<path
									d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z"
									stroke="currentColor"
									stroke-width="2"
									stroke-linejoin="round"
								></path>
								<path
									d="M9 9h6M9 13h6"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
								></path>
							</svg>
						</span>
					</button>
				</div>

				<ul class="cfs-trust-row" aria-label="Service highlights">
					{chips.map((chip) => <li>{chip}</li>)}
				</ul>

				<div class="cfs-hero-bottom-spacer" aria-hidden="true"></div>
			</div>
		</div>
	</div>
</section>
