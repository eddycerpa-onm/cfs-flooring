---
import { company } from '@/data/company';

const chips = [
  'Hardwood, Laminate & LVP',
  'Carpet Installation',
  'Sand & Finish',
  'Flooring Removal',
];
---

<section class="relative pt-[110px] pb-[84px] bg-gradient-to-b from-[var(--bg)] to-[var(--panel)] border-b border-[var(--stroke)] overflow-hidden min-h-[760px]">
  
  <!-- Right Video Frame (Positioned Absolutely to edge) -->
  <div class="hidden lg:block absolute right-0 top-0 w-[46vw] xl:w-[48vw] h-full overflow-hidden z-0">
    <div class="relative w-full h-full border-l border-y border-[var(--stroke)] rounded-l-[28px] overflow-hidden bg-[var(--panel)] shadow-2xl">
      <video
        autoplay
        loop
        muted
        playsinline
        poster="/src/assets/hero-poster.webp"
        class="w-full h-full object-cover"
      >
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-black/5 pointer-events-none"></div>
    </div>
  </div>

  <div class="max-w-hero mx-auto px-7 relative z-10">
    
    <div class="w-full lg:max-w-[662px] flex flex-col justify-center">
      
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center self-start px-[14px] py-[8px] rounded-full bg-[var(--panel)] border border-[var(--stroke)] text-[12px] font-extrabold uppercase tracking-[1.68px] text-[var(--accent)] mb-6 font-[var(--font-body)]">
        {company.name} LLC
      </div>

      <!-- H1 Title (Semantically unified H1 with 54px styled span) -->
      <h1 class="text-h1 font-extrabold font-[var(--font-title)] text-[var(--text)] mb-6">
        Quality flooring installation
        <span class="inline-block text-[54px] font-black leading-[54px] tracking-[-1.6px] text-white bg-[var(--text)] px-[14px] pt-[10px] pb-[12px] rounded-[16px] mt-2 align-middle shadow-sm font-[var(--font-title)]">
          with honest guidance<br/>you can trust
        </span>
      </h1>

      <!-- Subtitle Description -->
      <p class="max-w-[620px] text-[16px] font-normal text-[var(--muted)] leading-[27.2px] tracking-[-0.4px] font-[var(--font-body)] mb-8">
        Professional flooring installation for homes and businesses in Lake Oswego, West Linn, Wilsonville and Vancouver. With over 10 years of experience, Jose helps clients choose the right flooring for their space, budget, and long-term goals.
      </p>

      <!-- CTA Row: Experience Card + Get a Quote Button -->
      <div class="flex flex-wrap items-center gap-4 mb-8">
        <!-- Experience Card -->
        <div class="p-4 rounded-2xl bg-[var(--bg)] border border-[var(--stroke)] shadow-sm">
          <div class="text-sm font-black font-[var(--font-title)] text-[var(--text)]">
            10+ Years Experience
          </div>
          <div class="text-xs font-normal text-[var(--muted)] mt-0.5">
            Quality craftsmanship with personal service
          </div>
        </div>

        <!-- Get a Quote Button (Official Document Icon) -->
        <button
          type="button"
          @click="$dispatch('open-drawer')"
          class="inline-flex items-center justify-center gap-2.5 px-[18px] py-[14px] rounded-[16px] bg-[var(--accent-2)] text-[var(--dark-bg)] font-extrabold text-[16px] border border-[var(--accent-2)] shadow-md hover:bg-[var(--accent)] hover:border-[var(--accent)] hover:text-white transition-all cursor-pointer"
        >
          <span>Get a Quote</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="flex-shrink-0">
            <path d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
            <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <!-- Trust Chips Row -->
      <div class="flex flex-wrap items-center gap-2.5">
        {chips.map((chip) => (
          <span class="px-[14px] py-[8px] rounded-full bg-[var(--bg)] border border-[var(--stroke)] text-xs font-bold text-[var(--text)] shadow-2xs font-[var(--font-body)] capitalize">
            {chip}
          </span>
        ))}
      </div>

    </div>

  </div>
</section>
