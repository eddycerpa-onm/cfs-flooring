---
import { company } from '@/data/company';

const chips = [
  'Hardwood, Laminate & LVP',
  'Carpet Installation',
  'Sand & Finish',
  'Flooring Removal',
];
---

<section class="relative pt-hero-pt pb-hero-pb bg-gradient-to-b from-bg to-panel border-b border-stroke overflow-hidden min-h-hero-min flex items-center">
  
  <div class="cfs-base-container">
    <div class="cfs-banner-wrapper">
      
      <!-- Left Column: Copy (Fluid 52% width) -->
      <div class="cfs-banner-left">
        
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center self-start px-eyebrow-px py-eyebrow-py rounded-full bg-panel border border-stroke text-xs font-extrabold uppercase tracking-eyebrow text-accent mb-6 font-body">
          {company.name} LLC
        </div>

        <!-- H1 Title (Semantically unified H1 with 54px styled span) -->
        <h1 class="cfs-hero-h1">
          Quality flooring installation
          <span class="cfs-overlap-text-h1">
            with honest guidance<br />you can trust
          </span>
        </h1>

        <!-- Subtitle Description -->
        <p class="max-w-hero-desc text-hero-desc font-normal text-muted tracking-hero-desc font-body mb-8">
          Professional flooring installation for homes and businesses in Lake Oswego, West Linn, Wilsonville and Vancouver. With over 10 years of experience, Jose helps clients choose the right flooring for their space, budget, and long-term goals.
        </p>

        <!-- CTA Row: Experience Card + Get a Quote Button -->
        <div class="flex flex-wrap items-center gap-4 mb-4">
          <!-- Experience Card -->
          <div class="p-4 rounded-2xl bg-bg border border-stroke shadow-sm">
            <div class="text-sm font-black font-title text-text">
              10+ Years Experience
            </div>
            <div class="text-xs font-normal text-muted mt-0.5">
              Quality craftsmanship with personal service
            </div>
          </div>

          <!-- Get a Quote Button (Variant 2: Yellow -> Cafecito #b07f49 on hover) -->
          <button
            type="button"
            @click="$dispatch('open-drawer')"
            class="btn-yellow-accent"
          >
            <span>Get a Quote</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="shrink-0">
              <path d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
              <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <!-- Trust Chips Row (Exact 13px, font-normal 400, 8px 12px padding) -->
        <div class="flex flex-wrap items-center gap-2.5">
          {chips.map((chip) => (
            <span class="px-chip-px py-chip-py rounded-full bg-bg border border-stroke text-chip font-normal text-text capitalize font-body">
              {chip}
            </span>
          ))}
        </div>

      </div>

      <!-- Right Video Frame (Fluid 46% max 620px) -->
      <div class="hidden lg:block cfs-media-frame">
        <video
          autoplay
          loop
          muted
          playsinline
          poster="/src/assets/hero-poster.webp"
          class="w-full h-full object-cover"
          style="transform: scale(1.02);"
        >
          <source src="/videos/hero.mp4" type="video/mp4" />
        </video>
      </div>

    </div>
  </div>
</section>
