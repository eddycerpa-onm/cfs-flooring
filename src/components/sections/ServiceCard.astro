---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  shortTitle?: string;
  slug: string;
  description: string;
  image: any;
  href?: string;
}

const { title, slug, description, image, href: customHref } = Astro.props;
const targetSlug = slug.toLowerCase().replace(/^\/services\//, '').replace(/^\//, '');
const href = customHref || `/services/${targetSlug}`;
---

<a class="rr-svc-card" href={href} aria-label={`View ${title} details`} data-motion="fade-up-light">
  <div class="rr-svc-card-head">
    <h3 class="rr-svc-card-title">{title}</h3>
    <span class="rr-svc-circle" aria-hidden="true">
      <span class="rr-svc-circle-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="16" viewBox="0 0 27 20" fill="none">
          <path d="M26.2056 9.81638L17.5445 1.15529C17.2296 0.840385 16.7189 0.840384 16.404 1.15529C16.0891 1.47019 16.0891 1.98081 16.404 2.29571L23.6884 9.58008L1.1381 9.58011C0.915398 9.58016 0.71383 9.67038 0.567884 9.81633C0.421939 9.96227 0.331719 10.1638 0.331667 10.3865C0.331667 10.8319 0.692726 11.193 1.13812 11.193L23.6885 11.193L16.404 18.4775C16.0891 18.7924 16.0891 19.303 16.404 19.6179C16.7189 19.9328 17.2296 19.9328 17.5445 19.6179L26.2056 10.9568C26.5205 10.6419 26.5205 10.1313 26.2056 9.81638Z" fill="currentColor"/>
        </svg>
      </span>
    </span>
  </div>

  <p class="rr-svc-card-desc">{description}</p>

  <div class="rr-svc-image">
    <Image
      src={image}
      alt={`${title} - Professional Flooring Service in Lake Oswego & Portland Metro`}
      width={400}
      height={400}
      loading="lazy"
      decoding="async"
    />
  </div>

  <span class="rr-svc-mobilebtn" aria-hidden="true">
    Learn More
    <span class="rr-svc-mobilebtn-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
      </svg>
    </span>
  </span>
</a>

<style is:global>
  .rr-svc-card {
    flex: 0 0 calc((100% - 32px) / 3);
    width: calc((100% - 32px) / 3);
    background: var(--bg);
    border: 1px solid var(--stroke);
    border-radius: 18px;
    padding: 18px;
    min-height: 470px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow-custom, 0 18px 45px rgba(34, 20, 22, 0.12));
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    user-select: none;
    box-sizing: border-box;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  @media (max-width: 980px) {
    .rr-svc-card {
      flex: 0 0 86%;
      width: 86%;
      min-height: 500px;
    }
  }

  .rr-svc-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 24px 55px rgba(0, 0, 0, 0.12);
  }

  .rr-svc-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .rr-svc-card-title {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 900;
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.2px;
    color: var(--text);
  }

  .rr-svc-card-desc {
    margin: 0;
    font-family: var(--font-body);
    color: var(--muted);
    line-height: 1.72;
    font-size: 16px;
    max-width: 60ch;
  }

  .rr-svc-circle {
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    text-decoration: none;
    background: var(--accent);
    border: 1px solid var(--accent);
    color: var(--bg, #ffffff);
    transition: background-color 0.35s ease, border-color 0.35s ease, transform 0.2s ease, color 0.35s ease;
  }

  .rr-svc-circle-icon {
    display: inline-grid;
    place-items: center;
    transform: rotate(0deg);
    transition: transform 0.32s ease;
    transform-origin: 50% 50%;
  }

  .rr-svc-card:hover .rr-svc-circle {
    background: var(--dark-bg);
    border-color: var(--dark-bg);
    color: var(--accent-2);
    transform: translateY(-1px);
  }

  .rr-svc-card:hover .rr-svc-circle-icon {
    transform: rotate(45deg);
  }

  .rr-svc-image {
    margin-top: auto;
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--stroke);
    text-decoration: none;
    background: var(--panel);
  }

  .rr-svc-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 0.45s ease;
  }

  .rr-svc-card:hover .rr-svc-image img {
    transform: scale(1.06);
  }

  .rr-svc-mobilebtn {
    display: none;
    margin-top: 10px;
    width: 100%;
    text-align: center;
    padding: 14px 18px;
    border-radius: 16px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 800;
    border: 1px solid transparent;
    background: var(--accent-2);
    color: var(--dark-bg);
    transition: transform 0.25s ease, box-shadow 0.35s ease, background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    font-family: var(--font-body);
  }

  @media (max-width: 640px) {
    .rr-svc-mobilebtn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  .rr-svc-card:hover .rr-svc-mobilebtn {
    transform: translateY(-1px);
    background: var(--accent);
    color: var(--bg);
  }

  .rr-svc-mobilebtn-icon {
    margin-left: 10px;
    display: inline-grid;
    place-items: center;
    color: currentColor;
  }
</style>
