---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  shortTitle: string;
  slug: string;
  description: string;
  image: any;
}

const { title, shortTitle, slug, description, image } = Astro.props;
const href = `/services/${slug}`;
---

<article class="p-6 rounded-2xl bg-[var(--bg)] border border-[var(--stroke)] shadow-md hover:shadow-xl hover:border-[var(--accent)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between min-h-[460px] group">
  
  <div>
    <!-- Head Row: Title + Circle Arrow -->
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <span class="text-xs font-black uppercase tracking-wider text-[var(--accent)] font-[var(--font-title)]">
          {shortTitle}
        </span>
        <h3 class="text-xl font-bold font-[var(--font-title)] text-[var(--text)] group-hover:text-[var(--accent)] transition-colors mt-1">
          {title}
        </h3>
      </div>

      <a
        href={href}
        class="w-11 h-11 rounded-full bg-[var(--accent)] text-white flex items-center justify-center flex-shrink-0 group-hover:bg-[var(--dark-bg)] group-hover:text-[var(--accent-2)] transition-colors"
        aria-label={`View ${title} details`}
      >
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>

    <!-- Description -->
    <p class="text-sm text-[var(--muted)] leading-relaxed font-[var(--font-body)] mb-6">
      {description}
    </p>
  </div>

  <!-- Bottom Image Frame -->
  <a href={href} class="relative block rounded-2xl overflow-hidden aspect-square border border-[var(--stroke)] bg-[var(--panel)]">
    <Image
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      width={400}
      height={400}
    />
  </a>

</article>
