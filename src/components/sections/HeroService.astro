---
interface Props {
  title: string;
  description: string;
  heroTitle?: string;
  subtitle?: string;
  formHint?: string;
  features?: string[];
  slug?: string;
  image?: any;
  heroBadge?: string;
}

const { title, description, heroTitle, subtitle, formHint, heroBadge = 'Carpet • Padding • Installation' } = Astro.props;
const displayH1 = heroTitle || description;
const displaySub = subtitle || description;
---

<section class="flHero" id="floorHero" aria-label={`${title} Hero`}>
  <div class="flHero__bg" aria-hidden="true"></div>

  <div class="flHero__inner">
    <div class="flHero__left" data-motion-stagger="true">
      <div class="flHero__crumb" aria-label="Breadcrumb" data-motion="fade-up">
        <a href="/">Home</a>
        <span class="flHero__slash">/</span>
        <span>{title}</span>
      </div>

      <h1 class="flHero__title" data-motion="fade-up">
        {displayH1}
      </h1>

      <p class="flHero__sub" data-motion="fade-up">
        {displaySub}
      </p>

      <div class="flHero__chips" aria-label="Service highlights" data-motion="fade-up">
        <span class="chip"><span class="chipDot" aria-hidden="true"></span>{heroBadge}</span>
        <span class="chip"><span class="chipDot" aria-hidden="true"></span>Residential &amp; Commercial</span>
        <span class="chip"><span class="chipDot" aria-hidden="true"></span>Design Guidance • Installation</span>
      </div>
    </div>

    <aside class="flHero__right" aria-label={`${title} inquiry form`} data-motion="fade-left">
      <div class="formWrap">
        <div class="formInner">
          <p class="formHint">
            {formHint || `Request your ${title.toLowerCase()} consultation. Fill out the form and our team will reach out shortly.`}
          </p>

          <form id="heroServiceForm" class="nativeForm">
            <div class="formGroup">
              <label for="heroName">Full Name</label>
              <input type="text" id="heroName" name="name" required placeholder="Your full name" class="formInput" />
            </div>

            <div class="formGroup">
              <label for="heroPhone">Phone Number</label>
              <input type="tel" id="heroPhone" name="phone" required placeholder="(971) 419-8602" class="formInput" />
            </div>

            <div class="formGroup">
              <label for="heroEmail">Email Address</label>
              <input type="email" id="heroEmail" name="email" required placeholder="your@email.com" class="formInput" />
            </div>

            <div class="formGroup">
              <label for="heroMessage">Project Details</label>
              <textarea id="heroMessage" name="message" rows="3" placeholder="Tell us about your room size, timing, or flooring needs..." class="formTextarea"></textarea>
            </div>

            <!-- Required Consent Checkbox -->
            <div class="flex items-start gap-2.5 pt-1">
              <input
                type="checkbox"
                id="hero-consent"
                name="consent"
                required
                class="mt-1 w-4 h-4 rounded border-stroke text-accent focus:ring-accent accent-accent cursor-pointer shrink-0"
              />
              <label for="hero-consent" class="text-xs text-muted leading-relaxed cursor-pointer select-none">
                I agree to the <a href="/terms-and-conditions" target="_blank" class="font-bold text-text hover:text-accent underline">Terms & Conditions</a> and <a href="/privacy-policy" target="_blank" class="font-bold text-text hover:text-accent underline">Privacy Policy</a>, and consent to receive project communication regarding my estimate inquiry.
              </label>
            </div>

            <button type="submit" class="submitBtn">
              <span>Request Free Consultation</span>
            </button>
            <p id="heroFormStatus" class="formStatus" hidden></p>
          </form>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  const form = document.getElementById('heroServiceForm') as HTMLFormElement | null;
  const status = document.getElementById('heroFormStatus');

  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('.submitBtn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      status.hidden = false;
      status.style.color = 'var(--text)';
      status.textContent = 'Sending your request...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          status.style.color = '#10b981';
          status.textContent = 'Thank you! We will reach out shortly.';
          form.reset();
        } else {
          status.style.color = '#ef4444';
          status.textContent = 'Something went wrong. Please call us directly.';
        }
      } catch (err) {
        status.style.color = '#ef4444';
        status.textContent = 'Connection error. Please call us directly.';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  #floorHero,
  #floorHero * {
    box-sizing: border-box;
  }

  #floorHero {
    position: relative;
    background: linear-gradient(180deg, var(--bg), var(--panel));
    color: var(--text);
    font-family: var(--font-body);
    overflow: hidden;
    border-bottom: 1px solid var(--stroke);
  }

  #floorHero .flHero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(880px 520px at 14% 20%, rgba(176,127,73,.12), transparent 64%),
      radial-gradient(720px 460px at 84% 76%, rgba(247,209,51,.14), transparent 68%),
      linear-gradient(180deg, rgba(255,255,255,.10), rgba(34,20,22,.04));
    pointer-events: none;
  }

  #floorHero .flHero__bg::before {
    content: "";
    position: absolute;
    top: 0;
    right: -10%;
    width: min(42vw, 620px);
    height: 100%;
    background:
      linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,0)),
      linear-gradient(135deg, rgba(176,127,73,.14), rgba(247,209,51,.10));
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
    border-left: 1px solid rgba(34,20,22,.06);
    opacity: .9;
  }

  #floorHero .flHero__inner {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 0 auto;
    padding: clamp(52px, 6vw, 88px) 22px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, .95fr);
    gap: 28px;
    align-items: start;
  }

  #floorHero .flHero__left {
    max-width: 860px;
  }

  #floorHero .flHero__crumb {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 900;
    color: var(--muted);
  }

  #floorHero .flHero__crumb a {
    color: var(--text);
    text-decoration: none;
    transition: color .18s ease;
  }

  #floorHero .flHero__crumb a:hover {
    color: var(--accent);
  }

  #floorHero .flHero__slash {
    opacity: .7;
  }

  #floorHero .flHero__title {
    margin: 14px 0 0;
    font-family: var(--font-title);
    font-weight: 900;
    letter-spacing: -.03em;
    line-height: 1.02;
    font-size: clamp(38px, 4.8vw, 68px);
    color: var(--text);
    max-width: 18ch;
  }

  #floorHero .flHero__sub {
    margin: 16px 0 0;
    max-width: 74ch;
    color: var(--muted);
    line-height: 1.75;
    font-weight: 650;
    font-size: clamp(16px, 1.35vw, 20px);
  }

  #floorHero .flHero__chips {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  #floorHero .chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--stroke);
    background: rgba(255,255,255,.76);
    color: var(--text);
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-size: 11px;
    white-space: nowrap;
    box-shadow: var(--shadow);
  }

  #floorHero .chipDot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(176,127,73,.14);
    flex: 0 0 auto;
  }

  #floorHero .flHero__right {
    display: grid;
    align-content: start;
    justify-items: end;
    min-width: 0;
  }

  #floorHero .formWrap {
    width: min(540px, 100%);
    border-radius: 20px;
    border: 1px solid var(--stroke);
    background: rgba(255,255,255,.85);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
    overflow: visible;
  }

  #floorHero .formInner {
    padding: 24px;
  }

  #floorHero .formHint {
    margin: 0 0 16px;
    color: var(--text);
    font-weight: 800;
    font-size: 14px;
    line-height: 1.5;
  }

  .nativeForm {
    display: grid;
    gap: 14px;
  }

  .formGroup {
    display: grid;
    gap: 6px;
  }

  .formGroup label {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--text);
  }

  .formInput,
  .formTextarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--stroke);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .formInput:focus,
  .formTextarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(176, 127, 73, 0.15);
  }

  .submitBtn {
    width: 100%;
    padding: 14px 20px;
    border-radius: 14px;
    border: none;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-title);
    font-weight: 900;
    font-size: 15px;
    cursor: pointer;
    transition: transform .2s ease, background-color .2s ease, box-shadow .2s ease;
    box-shadow: var(--shadow);

    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .submitBtn:hover {
    background: var(--dark-bg);
    transform: translateY(-2px);
  }

  .formStatus {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 980px) {
    #floorHero .flHero__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 44px 16px;
    }

    #floorHero .flHero__right {
      justify-items: start;
    }

    #floorHero .formWrap {
      width: 100%;
    }
  }
</style>
