---
import { Image } from 'astro:assets';
import { company } from '../../data/company';
import Button from '../ui/Button.astro';
import Pill from '../ui/Pill.astro';

interface Props {
  title: string;
  description: string;
  features?: string[];
  slug?: string;
  image?: any;
}

const { title, description, features = [], image } = Astro.props;
---

<section class="bg-dark-bg text-white py-16 lg:py-24 border-b border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs mb-8 font-medium text-white/70" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent-2 transition-colors">Home</a>
      <span class="text-white/30">/</span>
      <a href="/services" class="hover:text-accent-2 transition-colors">Services</a>
      <span class="text-white/30">/</span>
      <span class="text-accent-2 font-bold">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Content -->
      <div class="lg:col-span-7 space-y-6">
        <Pill variant="dark">
          Professional Flooring Installation
        </Pill>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black font-title tracking-tight leading-tight text-white">
          {title}
        </h1>

        <p class="text-base sm:text-lg text-white/80 leading-relaxed font-normal">
          {description}
        </p>

        {
          features.length > 0 && (
            <div class="pt-2">
              <h2 class="text-xs font-bold uppercase tracking-wider text-accent-2 mb-3 font-title">Key Highlights:</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {features.map((feat) => (
                  <div class="flex items-start gap-2 text-sm text-white/90">
                    <svg class="w-5 h-5 text-accent-2 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <Button variant="accent" size="lg" isDrawer={true}>
            Request Free Estimate &rarr;
          </Button>

          <a
            href={`tel:${company.phoneRaw}`}
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border border-white/20 text-white font-bold font-title text-base hover:bg-white/10 transition-colors"
          >
            <svg class="w-5 h-5 text-accent-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Call {company.phone}
          </a>
        </div>
      </div>

      <!-- Right Column: Visual Card -->
      <div class="lg:col-span-5">
        <div class="p-6 rounded-3xl bg-white/5 border border-white/10 shadow-2xl backdrop-blur-md space-y-6">
          {image && (
            <div class="rounded-2xl overflow-hidden mb-4 border border-white/10">
              <Image src={image} alt={title} width={600} height={400} class="w-full h-48 object-cover" />
            </div>
          )}
          <div class="space-y-2 border-b border-white/10 pb-4">
            <div class="text-xs font-bold text-accent-2 uppercase tracking-wider font-title">Service Guarantee</div>
            <div class="text-xl font-bold font-title text-white">Why Choose CFS Flooring?</div>
          </div>

          <ul class="space-y-3 text-sm text-white/80">
            <li class="flex items-center justify-between py-1 border-b border-white/5">
              <span>Service Area:</span>
              <span class="font-bold text-white">Lake Oswego, West Linn, WA</span>
            </li>
            <li class="flex items-center justify-between py-1 border-b border-white/5">
              <span>Licensing:</span>
              <span class="font-bold text-accent-2">{company.licenses.oregonCCB}</span>
            </li>
            <li class="flex items-center justify-between py-1 border-b border-white/5">
              <span>Warranty:</span>
              <span class="font-bold text-white">Full Craftsmanship Guarantee</span>
            </li>
            <li class="flex items-center justify-between py-1 border-b border-white/5">
              <span>Turnaround:</span>
              <span class="font-bold text-white">Fast & Reliable On-Time</span>
            </li>
          </ul>

          <Button variant="primary" size="md" class="w-full" isDrawer={true}>
            Get Custom Quote
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>
