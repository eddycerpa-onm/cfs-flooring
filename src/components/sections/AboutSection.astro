---
import { Image } from 'astro:assets';
import slide1 from '@/assets/about/slide-1.webp';
import slide2 from '@/assets/about/slide-2.webp';
import slide3 from '@/assets/about/slide-3.webp';

const slides = [
  { img: slide1, alt: 'Modern interior with premium hardwood flooring', badge: 'Hardwood, Laminate & LVP' },
  { img: slide2, alt: 'Clean residential flooring installation', badge: 'Carpet & Residential Installation' },
  { img: slide3, alt: 'Detailed floor finishing and tile work', badge: 'Sand & Finish' }
];
---

<section id="about" class="py-about-pt pb-about-pb bg-gradient-to-b from-bg to-panel border-b border-stroke">
  <div class="base-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Col 1: Media Slider Frame with Alpine.js -->
      <div class="lg:col-span-6 relative" x-data="{ activeSlide: 0 }" data-motion="fade-right">
        <div class="relative min-h-about-frame-min sm:min-h-about-frame-sm-min rounded-3xl overflow-hidden bg-panel border border-stroke shadow-2xl">
          {slides.map((slide, idx) => (
            <div
              x-show={`activeSlide === ${idx}`}
              x-transition:enter="transition ease-out duration-500"
              x-transition:enter-start="opacity-0 scale-95"
              x-transition:enter-end="opacity-100 scale-100"
              class="absolute inset-0 w-full h-full"
            >
              <Image src={slide.img} alt={slide.alt} class="w-full h-full object-cover" width={600} height={580} />
              
              <div class="absolute bottom-5 left-5 z-10 px-4 py-2.5 rounded-full bg-accent-2 text-dark-bg text-sm font-black shadow-lg font-body">
                {slide.badge}
              </div>
            </div>
          ))}

          <!-- Slider Dots Navigation -->
          <div class="absolute bottom-5 right-5 z-20 flex items-center gap-2 bg-dark-bg/60 backdrop-blur-md px-3 py-1.5 rounded-full">
            {slides.map((_, idx) => (
              <button
                type="button"
                @click={`activeSlide = ${idx}`}
                class="w-11 h-11 grid place-items-center cursor-pointer"
                aria-label={`Slide ${idx + 1}`}
              >
                <span
                  class="h-2.5 rounded-full transition-all block"
                  :class={`activeSlide === ${idx} ? 'bg-accent-2 w-6' : 'bg-bg/60 w-2.5 hover:bg-bg'`}
                ></span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Col 2: Copy & List -->
      <div class="lg:col-span-6 flex flex-col justify-center" data-motion="fade-left">
        
        <div class="flex items-center gap-2 text-accent font-black text-xs uppercase tracking-widest mb-4 font-title">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16">
            <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
          </svg>
          <span>About CFS Flooring</span>
        </div>

        <h2 class="text-h2-about font-black font-title text-text mb-6">
          Flooring work built around quality, honesty, and the right fit for your space.
        </h2>

        <p class="max-w-about-desc text-about-desc text-muted font-body mb-about-desc-mb">
          CFS Flooring brings over 10 years of hands-on experience serving homes and businesses with a quality-first approach. We focus on helping clients choose the right material for their goals, timeline, and budget—whether that means hardwood, laminate, LVP, carpet, tile, sand and finish, or flooring removal.
        </p>

        <ul class="flex flex-col gap-4 mb-8 list-none p-0">
          <li class="flex items-start gap-3 text-base font-bold text-text">
            <span class="w-2.5 h-2.5 rounded-full bg-accent-2 mt-2 shrink-0"></span>
            <span>Personal guidance with honest recommendations based on your project goals</span>
          </li>
          <li class="flex items-start gap-3 text-base font-bold text-text">
            <span class="w-2.5 h-2.5 rounded-full bg-accent-2 mt-2 shrink-0"></span>
            <span>Residential and commercial flooring solutions with attention to labor quality</span>
          </li>
          <li class="flex items-start gap-3 text-base font-bold text-text">
            <span class="w-2.5 h-2.5 rounded-full bg-accent-2 mt-2 shrink-0"></span>
            <span>Trusted service in Lake Oswego, West Linn, and Wilsonville</span>
          </li>
        </ul>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/about-us"
            class="px-6 py-3.5 rounded-2xl border border-stroke bg-transparent text-text font-extrabold text-base hover:bg-panel hover:border-accent hover:text-accent transition-colors"
          >
            Learn More
          </a>

          <a
            href="/contact-us"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-accent-2 text-dark-bg font-extrabold text-base shadow-md hover:bg-accent hover:text-white transition-colors"
            aria-label="Get a free quote on Contact Us page"
          >
            <span>Get a Quote</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" />
            </svg>
          </a>
        </div>

      </div>

    </div>

    <!-- Stats Row Below -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-20" data-motion-stagger="true">
      <div data-motion="fade-up" class="p-8 rounded-2xl bg-bg border border-stroke shadow-md text-center">
        <div class="text-4xl sm:text-5xl font-black font-title text-accent">
          <span data-counter="10">0</span><span class="text-accent-2">+</span>
        </div>
        <div class="text-sm font-extrabold text-muted mt-2">Years Experience</div>
      </div>

      <div data-motion="fade-up" class="p-8 rounded-2xl bg-bg border border-stroke shadow-md text-center">
        <div class="text-4xl sm:text-5xl font-black font-title text-accent">
          <span data-counter="9">0</span>
        </div>
        <div class="text-sm font-extrabold text-muted mt-2">Core Services</div>
      </div>

      <div data-motion="fade-up" class="p-8 rounded-2xl bg-bg border border-stroke shadow-md text-center">
        <div class="text-4xl sm:text-5xl font-black font-title text-accent">
          <span data-counter="4">0</span>
        </div>
        <div class="text-sm font-extrabold text-muted mt-2">Primary Service Areas</div>
      </div>
    </div>

  </div>
</section>

<script>
  function initCounters() {
    const counterEls = document.querySelectorAll('[data-counter]');
    if (counterEls.length === 0) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const finalVal = parseInt(target.getAttribute('data-counter') || '0', 10);
          let currentVal = 0;
          const duration = 1200;
          const stepTime = Math.max(Math.floor(duration / finalVal), 50);

          const timer = setInterval(() => {
            currentVal += 1;
            target.innerText = String(currentVal);
            if (currentVal >= finalVal) {
              target.innerText = String(finalVal);
              clearInterval(timer);
            }
          }, stepTime);

          observer.unobserve(target);
        }
      });
    }, { threshold: 0.3 });

    counterEls.forEach(el => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounters);
  } else {
    initCounters();
  }
</script>
