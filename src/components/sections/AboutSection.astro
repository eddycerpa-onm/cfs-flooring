---
import { company } from '@/data/company';
import { Image } from 'astro:assets';

import slide1 from '@/assets/services/hardwood-lvp.webp';
import slide2 from '@/assets/services/carpet.webp';
import slide3 from '@/assets/services/sand-finish.webp';
---

<section id="about" class="py-[96px] pb-[180px] bg-gradient-to-b from-[var(--bg)] to-[var(--panel)] border-b border-[var(--stroke)]">
  <div class="max-w-base mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Col 1: Media Slider Frame -->
      <div class="lg:col-span-6 relative">
        <div class="relative min-h-[480px] sm:min-h-[560px] rounded-3xl overflow-hidden bg-[var(--panel)] border border-[var(--stroke)] shadow-2xl">
          <Image src={slide1} alt="Modern interior with premium hardwood flooring" class="w-full h-full object-cover" width={600} height={580} />
          
          <div class="absolute bottom-5 left-5 z-10 px-4 py-2.5 rounded-full bg-[var(--accent-2)] text-[var(--dark-bg)] text-sm font-black shadow-lg font-[var(--font-body)]">
            Hardwood, Laminate & LVP
          </div>
        </div>
      </div>

      <!-- Col 2: Copy & List -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        
        <div class="flex items-center gap-2 text-[var(--accent)] font-black text-xs uppercase tracking-widest mb-4 font-[var(--font-title)]">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16">
            <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
          </svg>
          <span>About CFS Flooring</span>
        </div>

        <h2 class="text-h2-about font-black font-[var(--font-title)] text-[var(--text)] mb-6">
          Flooring work built around quality, honesty, and the right fit for your space.
        </h2>

        <p class="max-w-[634px] text-[19px] text-[var(--muted)] leading-[36.1px] font-[var(--font-body)] mb-[28px]">
          CFS Flooring brings over 10 years of hands-on experience serving homes and businesses with a quality-first approach. We focus on helping clients choose the right material for their goals, timeline, and budget—whether that means hardwood, laminate, LVP, carpet, tile, sand and finish, or flooring removal.
        </p>

        <ul class="flex flex-col gap-4 mb-8 list-none p-0">
          <li class="flex items-start gap-3 text-base font-bold text-[var(--text)]">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-2)] mt-2 flex-shrink-0"></span>
            <span>Personal guidance with honest recommendations based on your project goals</span>
          </li>
          <li class="flex items-start gap-3 text-base font-bold text-[var(--text)]">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-2)] mt-2 flex-shrink-0"></span>
            <span>Residential and commercial flooring solutions with attention to labor quality</span>
          </li>
          <li class="flex items-start gap-3 text-base font-bold text-[var(--text)]">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-2)] mt-2 flex-shrink-0"></span>
            <span>Trusted service in Lake Oswego, West Linn, and Wilsonville</span>
          </li>
        </ul>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/about-us"
            class="px-6 py-3.5 rounded-2xl border border-[var(--stroke)] bg-transparent text-[var(--text)] font-extrabold text-base hover:bg-[var(--panel)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all"
          >
            Learn More
          </a>

          <button
            type="button"
            @click="$dispatch('open-drawer')"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-[var(--accent-2)] text-[var(--dark-bg)] font-extrabold text-base shadow-md hover:bg-[var(--accent)] hover:text-white transition-all"
          >
            <span>Get a Quote</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" />
            </svg>
          </button>
        </div>

      </div>

    </div>

    <!-- Stats Row Below -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-20">
      <div class="p-8 rounded-2xl bg-[var(--bg)] border border-[var(--stroke)] shadow-md text-center">
        <div class="text-4xl sm:text-5xl font-black font-[var(--font-title)] text-[var(--accent)]">
          10<span class="text-[var(--accent-2)]">+</span>
        </div>
        <div class="text-sm font-extrabold text-[var(--muted)] mt-2">Years Experience</div>
      </div>

      <div class="p-8 rounded-2xl bg-[var(--bg)] border border-[var(--stroke)] shadow-md text-center">
        <div class="text-4xl sm:text-5xl font-black font-[var(--font-title)] text-[var(--accent)]">
          8
        </div>
        <div class="text-sm font-extrabold text-[var(--muted)] mt-2">Core Flooring Services</div>
      </div>

      <div class="p-8 rounded-2xl bg-[var(--bg)] border border-[var(--stroke)] shadow-md text-center">
        <div class="text-4xl sm:text-5xl font-black font-[var(--font-title)] text-[var(--accent)]">
          4
        </div>
        <div class="text-sm font-extrabold text-[var(--muted)] mt-2">Primary Service Areas</div>
      </div>
    </div>

  </div>
</section>
