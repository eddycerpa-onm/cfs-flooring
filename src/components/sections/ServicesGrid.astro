---
import ServiceCard from '@/components/sections/ServiceCard.astro';

interface Props {
  services: Array<{
    data: {
      title: string;
      shortTitle: string;
      slug: string;
      cardDescription: string;
      order: number;
    };
  }>;
  imagesMap: Record<string, any>;
}

const { services, imagesMap } = Astro.props;
const sortedServices = [...services].sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="pt-services-pt pb-services-pb bg-bg border-b border-stroke">
  <div class="max-w-base mx-auto px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-accent font-black text-xs uppercase tracking-widest mb-3 font-title">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16">
            <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
          </svg>
          <span>Services</span>
        </div>

        <h2 class="max-w-services-title text-h2-service font-black font-title text-text mb-services-title-mb">
          Flooring services built for homes, businesses, and long-term value.
        </h2>

        <p class="max-w-services-desc text-services-desc text-muted font-body m-0">
          CFS Flooring provides professional flooring installation, restoration, and replacement services with a quality-first approach across Lake Oswego, West Linn, Wilsonville and Vancouver.
        </p>
      </div>

      <div class="shrink-0">
        <button
          type="button"
          @click="$dispatch('open-drawer')"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-accent-2 text-dark-bg font-extrabold text-base border border-accent-2 shadow-md hover:bg-accent hover:border-accent hover:text-white transition-all cursor-pointer"
        >
          <span>Get a Quote</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 8 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedServices.map((service) => (
        <ServiceCard
          title={service.data.title}
          shortTitle={service.data.shortTitle}
          slug={service.data.slug}
          description={service.data.cardDescription}
          image={imagesMap[service.data.slug]}
        />
      ))}
    </div>

  </div>
</section>
