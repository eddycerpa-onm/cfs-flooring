---
import ServiceCard from '@/components/sections/ServiceCard.astro';

interface Props {
  services: Array<{
    data: {
      title: string;
      shortTitle: string;
      slug: string;
      cardDescription: string;
      order: number;
    };
  }>;
  imagesMap: Record<string, any>;
}

const { services, imagesMap } = Astro.props;
const sortedServices = [...services].sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="rr-services rr-services--light" aria-label="Services">
  <div class="rr-services-inner">
    
    <!-- Section Header -->
    <div class="rr-services-head">
      <div class="rr-services-kicker" data-motion="fade-up">
        <span class="rr-services-kicker-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
          </svg>
        </span>
        <span class="rr-services-kicker-text">Services</span>
      </div>

      <div class="rr-services-titlegrid">
        <div class="rr-services-titleleft" data-motion="fade-right">
          <h2 class="rr-services-title">Flooring services built for homes, businesses, and long-term value.</h2>
          <p class="rr-services-sub">
            CFS Flooring provides professional flooring installation, restoration, and replacement services with a quality-first approach. From hardwood, laminate, and LVP to carpet, tile, VCT, and flooring removal, every project is guided with honest recommendations and clean workmanship.
          </p>
        </div>

        <div class="rr-services-titleright" data-motion="fade-left">
          <a
            href="/contact-us"
            class="primary-button rr-services-quote-trigger"
            aria-label="Get a free quote on Contact Us page"
          >
            <span>Get a Quote</span>
            <span class="btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false">
                <path d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Interactive Services Carousel / Slider -->
    <div class="rr-svc-slider" role="region" aria-label="Services carousel">
      <div id="svcViewport" class="rr-svc-viewport" tabindex="0" aria-label="Service cards">
        <div id="svcTrack" class="rr-svc-track" data-motion-stagger="true">
          {sortedServices.map((service) => (
            <ServiceCard
              title={service.data.title}
              shortTitle={service.data.shortTitle}
              slug={service.data.slug}
              description={service.data.cardDescription}
              image={imagesMap[service.data.slug]}
            />
          ))}
        </div>
      </div>

      <!-- Carousel Navigation Controls -->
      <div class="rr-svc-nav" aria-label="Service slider controls">
        <button id="svcPrev" class="rr-svc-arrow" type="button" aria-label="Previous slide">
          ‹
        </button>
        <div id="svcDots" class="rr-svc-dots" role="tablist" aria-label="Select slide"></div>
        <button id="svcNext" class="rr-svc-arrow" type="button" aria-label="Next slide">
          ›
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  function initServiceSlider() {
    const trackEl = document.getElementById("svcTrack");
    const viewportEl = document.getElementById("svcViewport");
    const prev = document.getElementById("svcPrev") as HTMLButtonElement | null;
    const next = document.getElementById("svcNext") as HTMLButtonElement | null;
    const dotsWrapEl = document.getElementById("svcDots");
    if (!trackEl || !viewportEl || !dotsWrapEl) return;

    const track = trackEl;
    const viewport = viewportEl;
    const dotsWrap = dotsWrapEl;

    const cards = Array.from(track.querySelectorAll(".rr-svc-card")) as HTMLElement[];
    if (cards.length === 0) return;

    let index = 0;

    function perView() {
      return window.matchMedia("(max-width: 980px)").matches ? 1 : 3;
    }

    function gapPx() {
      const cs = getComputedStyle(track);
      const g = parseFloat(cs.columnGap || cs.gap || "16");
      return Number.isFinite(g) ? g : 16;
    }

    function cardW() {
      const first = cards[0];
      return first ? first.getBoundingClientRect().width : 0;
    }

    function step() {
      return cardW() + gapPx();
    }

    function maxIndex() {
      return Math.max(0, cards.length - perView());
    }

    function pagesCount() {
      if (perView() === 1) return cards.length;
      return maxIndex() + 1;
    }

    function setDots() {
      dotsWrap.innerHTML = "";
      const pages = pagesCount();

      for (let i = 0; i < pages; i++) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "rr-svc-dot" + (i === index ? " is-active" : "");
        b.setAttribute("role", "tab");
        b.setAttribute("aria-label", `Slide ${i + 1}`);
        b.setAttribute("aria-selected", i === index ? "true" : "false");
        b.addEventListener("click", () => {
          index = Math.min(maxIndex(), Math.max(0, i));
          render();
        });
        dotsWrap.appendChild(b);
      }
    }

    function render() {
      const x = -index * step();
      track.style.transform = `translate3d(${x}px, 0, 0)`;

      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= maxIndex();

      setDots();
    }

    function goNext() {
      if (index < maxIndex()) {
        index = Math.min(maxIndex(), index + 1);
        render();
      }
    }

    function goPrev() {
      if (index > 0) {
        index = Math.max(0, index - 1);
        render();
      }
    }

    if (prev) prev.addEventListener("click", goPrev);
    if (next) next.addEventListener("click", goNext);

    let startX = 0;
    let isDragging = false;

    viewport.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    viewport.addEventListener("touchend", (e) => {
      if (!isDragging) return;
      isDragging = false;
      const endX = e.changedTouches[0].clientX;
      const diffX = startX - endX;

      if (diffX > 40) {
        goNext();
      } else if (diffX < -40) {
        goPrev();
      }
    }, { passive: true });

    window.addEventListener("resize", render);
    render();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServiceSlider);
  } else {
    initServiceSlider();
  }
</script>

<style is:global>
  .rr-services--light {
    background: var(--bg);
    color: var(--text);
    padding: 80px 0 72px;
  }

  .rr-services-inner {
    max-width: var(--width-base, 1280px);
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .rr-services-head {
    margin-bottom: 34px;
  }

  .rr-services-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .rr-services-kicker-icon {
    color: var(--accent);
    display: inline-grid;
    place-items: center;
  }

  .rr-services-kicker-text {
    font-family: var(--font-title);
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    color: var(--accent);
  }

  .rr-services-titlegrid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: end;
  }

  .rr-services-title {
    margin: 0 0 10px;
    font-family: var(--font-title);
    font-weight: 900;
    letter-spacing: -0.8px;
    font-size: clamp(34px, 2.9vw, 48px);
    line-height: 1.06;
    color: var(--text);
    max-width: 1043px;
  }

  .rr-services-sub {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--muted);
    max-width: 74ch;
  }

  .rr-services .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    border-radius: 16px;
    padding: 14px 18px;
    transition: transform 0.25s ease, box-shadow 0.35s ease, background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    border: 1px solid var(--accent-2);
    white-space: nowrap;
    font-family: var(--font-body);
    background: var(--accent-2);
    color: var(--dark-bg);
    box-shadow: var(--shadow-custom, 0 18px 45px rgba(34, 20, 22, 0.12));
    cursor: pointer;
  }

  .rr-services .primary-button:hover {
    transform: translateY(-1px);
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .rr-services .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .rr-svc-viewport {
    overflow: hidden;
    border-radius: 18px;
    outline: none;
    padding-top: 18px;
  }

  .rr-svc-track {
    display: flex;
    gap: 16px;
    padding: 2px;
    transform: translate3d(0, 0, 0);
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .rr-svc-nav {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-top: 14px;
  }

  .rr-svc-arrow {
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
    flex: 0 0 46px;
    border-radius: 16px;
    border: 1px solid var(--stroke);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.35s ease, border-color 0.35s ease, transform 0.2s ease, color 0.35s ease;
    display: grid;
    place-items: center;
    font-size: 24px;
    line-height: 1;
    padding: 0;
    box-sizing: border-box;
  }

  .rr-svc-arrow:hover {
    transform: translateY(-1px);
    background: var(--accent-2);
    border-color: var(--accent-2);
    color: var(--dark-bg);
  }

  .rr-svc-arrow:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  .rr-svc-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rr-svc-dot {
    width: 16px;
    height: 10px;
    min-width: 16px;
    min-height: 10px;
    flex: 0 0 16px;
    border-radius: 999px;
    border: 1px solid var(--stroke);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.35s ease, border-color 0.35s ease, transform 0.2s ease;
    padding: 0;
    box-sizing: border-box;
    appearance: none;
    outline: none;
  }

  .rr-svc-dot:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }

  .rr-svc-dot.is-active {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(176, 127, 73, 0.12);
  }

  @media (max-width: 980px) {
    .rr-services-inner {
      padding: 0 18px;
    }

    .rr-services-titlegrid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .rr-services-titleright {
      margin-top: 8px;
    }
  }
</style>
