---
import { testimonials } from '@/data/testimonials';
import { Image } from 'astro:assets';
import testimonialMediaImg from '@/assets/testimonials/hero.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section id="testimonials" class:list={['py-24 bg-dark-bg text-bg border-b border-stroke overflow-hidden', className]}>
  <div class="base-container">
    
    <!-- Section Header -->
    <div class="mb-12">
      <div class="flex items-center gap-2 text-accent-2 font-black text-xs uppercase tracking-widest mb-3 font-title" data-motion="fade-up">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16">
          <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
        </svg>
        <span>Testimonials</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-title text-white max-w-4xl tracking-tight leading-tight" data-motion="fade-up">
        What homeowners and property owners are saying about CFS Flooring
      </h2>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Media Image (Original WebP Image) -->
      <div class="lg:col-span-6" data-motion="fade-right">
        <div class="relative aspect-square w-full max-w-testimonials-media rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-panel">
          <Image
            src={testimonialMediaImg}
            alt="CFS Flooring project quality testimonial"
            class="w-full h-full object-cover"
            width={560}
            height={560}
            loading="lazy"
          />
          
          <div class="absolute top-4 right-4 w-14 h-14 rounded-2xl bg-accent-2 text-dark-bg flex items-center justify-center shadow-xl">
            <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
              <path d="M10.2 11.2c0 3.4-1.9 6.3-5.2 7.1l-.7-1.6c2.1-.7 3.2-2.1 3.4-3.7H4.3V6.9h5.9v4.3z"/>
              <path d="M21.1 11.2c0 3.4-1.9 6.3-5.2 7.1l-.7-1.6c2.1-.7 3.2-2.1 3.4-3.7h-3.4V6.9h5.9v4.3z"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Right Testimonial Slider with Smooth Animation -->
      <div class="lg:col-span-6 flex flex-col justify-between" x-data="{ active: 0 }" data-motion="fade-left">
        <div class="relative min-h-[220px]">
          {testimonials.map((t, idx) => (
            <div
              x-show={`active === ${idx}`}
              x-cloak
              x-transition:enter="transition ease-out duration-300 transform"
              x-transition:enter-start="opacity-0 translate-x-6 scale-98"
              x-transition:enter-end="opacity-100 translate-x-0 scale-100"
              x-transition:leave="transition ease-in duration-200 transform absolute inset-0"
              x-transition:leave-start="opacity-100 translate-x-0 scale-100"
              x-transition:leave-end="opacity-0 -translate-x-6 scale-98"
              class="flex flex-col gap-6"
            >
              <p class="text-xl sm:text-2xl text-white/90 leading-relaxed italic font-body">
                "{t.text}"
              </p>

              <div class="flex items-center gap-4 pt-4 border-t border-white/10">
                <div class="w-14 h-14 rounded-full overflow-hidden border border-white/20 shrink-0">
                  <Image src={t.avatar} alt={t.author} width={56} height={56} class="w-full h-full object-cover" />
                </div>
                <div>
                  <h3 class="text-lg font-bold font-title text-white">{t.author}</h3>
                  <p class="text-sm text-white/70">{t.service} • {t.location}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Slider Controls -->
        <div class="flex items-center justify-end gap-3 mt-8">
          <button
            type="button"
            @click={`active = (active === 0) ? ${testimonials.length - 1} : active - 1`}
            class="w-12 h-12 rounded-2xl bg-accent text-white flex items-center justify-center hover:bg-accent-2 hover:text-dark-bg transition-all transform hover:-translate-y-0.5 cursor-pointer shadow-md"
            aria-label="Previous testimonial"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            @click={`active = (active === ${testimonials.length - 1}) ? 0 : active + 1`}
            class="w-12 h-12 rounded-2xl bg-accent text-white flex items-center justify-center hover:bg-accent-2 hover:text-dark-bg transition-all transform hover:-translate-y-0.5 cursor-pointer shadow-md"
            aria-label="Next testimonial"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

      </div>

    </div>

  </div>
</section>
