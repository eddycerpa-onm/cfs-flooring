---
const marqueeItems = [
  'Hardwood, Laminate & LVP',
  'Carpet Installation',
  'Sand & Finish',
  'Ceramic Tile',
  'Sheet Vinyl',
  'VCT Flooring',
  'Flooring Removal',
  'Residential & Commercial Flooring',
];
---

<div class="w-full bg-[var(--dark-bg)] border-y border-[var(--stroke)] h-[91px] flex items-center overflow-hidden select-none">
  <div class="inline-flex w-max flex-nowrap animate-marquee gap-12">
    
    <!-- Loop 1 -->
    <div class="flex items-center gap-12 flex-shrink-0">
      {marqueeItems.map((item) => (
        <a
          href="#services"
          class="flex items-center gap-4 text-[26px] font-black font-[var(--font-title)] text-[var(--accent-2)] tracking-wide hover:opacity-90 transition-opacity whitespace-nowrap"
        >
          <span>{item}</span>
          <svg class="w-[18px] h-[18px] text-[var(--accent-2)] flex-shrink-0" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- Loop 2 -->
    <div class="flex items-center gap-12 flex-shrink-0" aria-hidden="true">
      {marqueeItems.map((item) => (
        <a
          href="#services"
          class="flex items-center gap-4 text-[26px] font-black font-[var(--font-title)] text-[var(--accent-2)] tracking-wide hover:opacity-90 transition-opacity whitespace-nowrap"
        >
          <span>{item}</span>
          <svg class="w-[18px] h-[18px] text-[var(--accent-2)] flex-shrink-0" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z"/>
          </svg>
        </a>
      ))}
    </div>

  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
