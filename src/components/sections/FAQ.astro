---
import { faqsData as defaultFaqs } from '@/data/faqs';
import type { ServiceFAQ } from '@/data/services';
import FAQSchema from '@/components/seo/FAQSchema.astro';

interface Props {
  faqs?: ServiceFAQ[] | typeof defaultFaqs;
  title?: string;
}

const { faqs = defaultFaqs, title = "FAQs About CFS Flooring" } = Astro.props;
---

<!-- CFS Flooring • FAQ (1:1 original site specification) -->
<section class="cb-faq" id="faq" aria-label="Frequently Asked Questions">
  <FAQSchema faqs={faqs} />
  <div class="cb-faq-inner">
    
    <!-- Header -->
    <div class="cb-faq-head">
      <h2 class="cb-faq-title">{title}</h2>
    </div>

    <!-- Accordion List -->
    <div class="cb-faq-list" x-data="{ openIdx: null }">
      {faqs.map((faq, idx) => (
        <article class="cb-faq-item" :class={`openIdx === ${idx} ? 'is-open' : ''`}>
          <h3>
            <button
              class="cb-faq-toggle"
              type="button"
              @click={`openIdx = (openIdx === ${idx}) ? null : ${idx}`}
              :aria-expanded={`openIdx === ${idx}`}
              aria-controls={`faq-answer-${idx}`}
            >
              <span>{faq.question}</span>
              <span class="cb-faq-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          </h3>
          <div
            id={`faq-answer-${idx}`}
            class="cb-faq-answer"
            x-show={`openIdx === ${idx}`}
            x-cloak
            x-collapse
          >
            <p>{faq.answer}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style is:global>
  .cb-faq {
    padding: clamp(90px, 8vw, 130px) 0;
    background: var(--bg);
    color: var(--text);
    border-bottom: 1px solid var(--stroke);
  }

  .cb-faq-inner {
    max-width: 980px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .cb-faq-head {
    margin-bottom: clamp(38px, 4vw, 54px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .cb-faq-head::before,
  .cb-faq-head::after {
    content: "";
    height: 2px;
    flex: 1 1 0%;
    max-width: 180px;
    border-radius: 999px;
  }

  .cb-faq-head::before {
    background: linear-gradient(90deg, transparent 0%, var(--accent-2) 100%);
  }

  .cb-faq-head::after {
    background: linear-gradient(90deg, var(--accent-2) 0%, transparent 100%);
  }

  .cb-faq-title {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 44px);
    font-family: var(--font-title);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.6px;
    color: var(--text);
    white-space: nowrap;
  }

  .cb-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cb-faq-item {
    border: 1px solid var(--stroke);
    border-radius: 16px;
    overflow: hidden;
    background: var(--panel);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cb-faq-item.is-open {
    border-color: var(--accent);
    box-shadow: var(--shadow-custom, 0 18px 45px rgba(34, 20, 22, 0.06));
  }

  .cb-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px 24px;
    font-family: var(--font-title);
    font-weight: 800;
    font-size: clamp(16px, 1.3vw, 18px);
    color: var(--text);
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
  }

  .cb-faq-toggle:hover,
  .cb-faq-item.is-open .cb-faq-toggle {
    color: var(--accent);
  }

  .cb-faq-icon {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--stroke);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: background-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
    color: var(--text);
  }

  .cb-faq-item.is-open .cb-faq-icon {
    background: var(--accent);
    color: var(--bg);
    transform: rotate(45deg);
  }

  .cb-faq-answer {
    padding: 0 24px 20px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.7;
    color: var(--text);
    font-family: var(--font-body);
  }

  .cb-faq-answer p {
    margin: 0;
  }

  @media (max-width: 980px) {
    .cb-faq-inner {
      padding: 0 18px;
    }

    .cb-faq-head::before,
    .cb-faq-head::after {
      max-width: 80px;
    }

    .cb-faq-toggle {
      padding: 16px 18px;
    }

    .cb-faq-answer {
      padding: 0 18px 16px;
    }
  }

  @media (max-width: 520px) {
    .cb-faq-head::before,
    .cb-faq-head::after {
      display: none;
    }
  }
</style>
