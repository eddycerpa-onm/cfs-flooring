---
import { company } from '@/data/company';
---

<section id="rrFreeInspectionCta" class="py-[160px] bg-[var(--dark-bg)] text-white border-b border-[var(--stroke)]">
  <div class="max-w-base mx-auto px-6">
    
    <div class="max-w-[842px]">
      
      <!-- Title -->
      <h2 class="text-h2-cta font-black font-[var(--font-title)] text-white mb-[12px]">
        Ready to upgrade your floors with honest guidance and quality workmanship?
      </h2>

      <!-- Lead text -->
      <p class="max-w-[676px] text-[19px] font-[700] text-white/85 leading-[32.3px] font-[var(--font-body)] mb-[18px]">
        Whether you need hardwood, laminate, LVP, carpet, tile, sheet vinyl, sand and finish, or flooring removal, CFS Flooring is here to help you choose the right solution for your home or business.
      </p>

      <!-- Action Buttons Row -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <button
          type="button"
          @click="$dispatch('open-drawer')"
          class="inline-flex items-center justify-center gap-2.5 w-[240px] max-w-full px-[22px] py-[16px] rounded-[16px] bg-[var(--accent-2)] text-[var(--dark-bg)] font-black text-[16px] border border-[var(--accent-2)] hover:bg-[var(--accent)] hover:border-[var(--accent)] hover:text-white transition-all cursor-pointer"
        >
          <span>Get a Quote</span>
        </button>

      </div>
    </div>

  </div>
</section>
