---
import ctaBg from '@/assets/cta-bg.webp';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Ready to upgrade your floors with honest guidance and quality workmanship?",
  subtitle = "Whether you need hardwood, laminate, LVP, carpet, tile, sheet vinyl, sand and finish, or flooring removal, CFS Flooring is here to help you choose the right solution for your home or business."
} = Astro.props;
---

<!-- ============== CTA (CFS FLOORING) ============== -->
<section class="rr-cta-free" id="rrFreeInspectionCta" aria-label="CFS Flooring call to action">
  <div class="rr-cta-free-inner">
    <div class="rr-cta-free-card" data-motion-stagger="true">
      <div class="rr-cta-free-eyebrow" data-motion="fade-up">
        <span class="rr-cta-free-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334"/>
          </svg>
        </span>
        <span class="rr-cta-free-eyebrow-text">CFS Flooring LLC</span>
      </div>

      <h2 class="rr-cta-free-title" data-motion="fade-up">{title}</h2>

      <p class="rr-cta-free-lead" data-motion="fade-up">
        {subtitle}
      </p>

      <div class="rr-cta-free-actions" data-motion="fade-up">
        <a
          href="/contact-us"
          class="rr-btn rr-btn-primary rr-cta-free-btn"
          aria-label="Get a free quote on Contact Us page"
        >
          Get a Quote
          <span class="rr-btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false">
              <path d="M14 3H7a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-7-6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global define:vars={{ ctaBgUrl: `url(${ctaBg.src})` }}>
  .rr-cta-free,
  .rr-cta-free * {
    box-sizing: border-box;
  }

  .rr-cta-free {
    position: relative;
    padding: clamp(124px, 10vw, 160px) 0;
    overflow: hidden;
    background: var(--dark-bg);
    border-bottom: 1px solid var(--stroke);
    font-family: var(--font-body);
    color: var(--bg);
    isolation: isolate;
  }

  .rr-cta-free::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--ctaBgUrl);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 0;
  }

  .rr-cta-free::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10, 10, 10, 0.82) 0%, rgba(20, 20, 20, 0.65) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .rr-cta-free-inner {
    position: relative;
    z-index: 1;
    max-width: 1520px;
    width: 100%;
    margin: 0 auto;
    padding: 0 22px;
  }

  .rr-cta-free-card {
    width: min(100%, 900px);
    max-width: 100%;
    border-radius: 22px;
    padding: 28px 28px;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: var(--shadow-custom, 0 18px 45px rgba(34, 20, 22, 0.12));
  }

  .rr-cta-free-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.90);
    font-weight: 900;
    letter-spacing: 0.2px;
  }

  .rr-cta-free-icon {
    color: var(--accent-2);
    display: inline-grid;
    place-items: center;
  }

  .rr-cta-free-eyebrow-text {
    font-family: var(--font-title);
    text-transform: uppercase;
  }

  .rr-cta-free-title {
    margin: 0 0 12px;
    color: var(--bg);
    font-family: var(--font-title);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.6px;
    font-size: clamp(30px, 3.2vw, 46px);
  }

  .rr-cta-free-lead {
    margin: 0 0 18px;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.7;
    max-width: 760px;
    font-weight: 650;
    font-family: var(--font-body);
  }

  .rr-cta-free-actions {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 8px;
    width: 100%;
  }

  .rr-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 22px;
    border-radius: 16px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 900;
    border: 1px solid transparent;
    transition: background 0.22s ease, border-color 0.22s ease, transform 0.15s ease, color 0.22s ease;
    white-space: nowrap;
    font-family: var(--font-body);
    cursor: pointer;
  }

  .rr-btn:hover {
    transform: translateY(-1px);
  }

  .rr-btn-primary {
    background: var(--accent-2);
    color: var(--dark-bg);
    box-shadow: var(--shadow-custom, 0 18px 45px rgba(34, 20, 22, 0.12));
  }

  .rr-btn-primary:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .rr-btn-icon {
    margin-left: 12px;
    display: inline-grid;
    place-items: center;
    color: currentColor;
  }

  .rr-cta-free-btn {
    min-width: 240px;
    max-width: 100%;
  }

  .rr-cta-free-dropdown {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 100%;
  }

  .rr-cta-free-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--bg);
    text-decoration: none;
    font-weight: 900;
    padding: 14px 18px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.09);
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.15s ease, background 0.18s ease;
    white-space: nowrap;
    font-family: var(--font-body);
    cursor: pointer;
    max-width: 100%;
  }

  .rr-cta-free-secondary:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
    background: rgba(255, 255, 255, 0.14);
    transform: translateY(-1px);
  }

  .rr-cta-free-caret {
    transition: transform 0.22s ease;
  }

  .rr-cta-free-dropdown.is-open .rr-cta-free-caret {
    transform: rotate(180deg);
  }

  .rr-cta-free-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    min-width: 260px;
    max-width: min(100%, 320px);
    background: var(--bg);
    border: 1px solid var(--stroke);
    border-radius: 16px;
    box-shadow: var(--shadow-custom, 0 18px 45px rgba(34, 20, 22, 0.12));
    padding: 10px;
    margin-top: 10px;
    display: grid;
    gap: 4px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      max-height 0.28s ease,
      opacity 0.22s ease,
      transform 0.22s ease,
      margin-top 0.22s ease,
      visibility 0s linear 0.28s;
  }

  .rr-cta-free-dropdown.is-open .rr-cta-free-menu {
    max-height: 220px;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      max-height 0.32s ease,
      opacity 0.24s ease,
      transform 0.24s ease,
      margin-top 0.24s ease,
      visibility 0s linear 0s;
  }

  .rr-cta-free-menu-item {
    display: block;
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    transition: background 0.18s ease, color 0.18s ease, transform 0.15s ease;
    word-break: break-word;
  }

  .rr-cta-free-menu-item:hover {
    background: var(--panel);
    color: var(--accent);
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .rr-cta-free-inner {
      padding: 0 14px;
    }

    .rr-cta-free-card {
      width: 100%;
      padding: 20px 18px;
      border-radius: 18px;
    }

    .rr-cta-free-actions {
      gap: 12px;
    }

    .rr-cta-free-btn {
      width: 100%;
      min-width: 0;
    }

    .rr-cta-free-dropdown {
      width: 100%;
    }

    .rr-cta-free-secondary {
      width: 100%;
      justify-content: center;
    }

    .rr-cta-free-menu {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }
  }
</style>
