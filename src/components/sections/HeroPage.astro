---
import Pill from '../ui/Pill.astro';
import { Image } from 'astro:assets';

interface Breadcrumb {
  label?: string;
  name?: string;
  href?: string;
  url?: string;
}

interface StatItem {
  kicker: string;
  value: string;
}

interface Props {
  title: string;
  description?: string;
  subtitle?: string;
  pillText?: string;
  eyebrow?: string;
  breadcrumbs?: Breadcrumb[];
  dark?: boolean;
  image?: any;
  stats?: StatItem[];
  subtitleClass?: string;
}

const {
  title,
  description,
  subtitle,
  pillText,
  eyebrow,
  breadcrumbs = [],
  dark = false,
  image,
  stats = [],
  subtitleClass = '',
} = Astro.props;

const badgeText = pillText || eyebrow;
const bodyText = description || subtitle;
const hasBgImage = Boolean(image);
---

<section class:list={[
  'py-16 md:py-24 border-b border-stroke relative overflow-hidden',
  hasBgImage ? 'text-white' : dark ? 'bg-dark-bg text-white' : 'bg-panel text-text'
]}>
  {hasBgImage && (
    <div class="z-0 absolute inset-0 overflow-hidden">
      {typeof image === 'string' ? (
        <img src={image} alt={title} width="1600" height="700" class="w-full h-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
      ) : (
        <Image src={image} alt={title} width={1600} height={700} class="w-full h-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
      )}
      <!-- Dark Overlay Gradient for 100% Text Legibility -->
      <div class="z-1 absolute inset-0 bg-linear-to-r from-dark-bg/95 via-dark-bg/85 to-dark-bg/60"></div>
      <div class="z-1 absolute inset-0 bg-dark-bg/40"></div>
    </div>
  )}

  <div class="z-10 relative mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl" data-motion-stagger="true">
    
    <!-- Breadcrumbs -->
    {
      breadcrumbs.length > 0 && (
        <nav class="flex items-center gap-2 mb-6 font-medium text-xs" aria-label="Breadcrumb" data-motion="fade-up">
          <a href="/" class:list={['hover:underline transition-colors', (hasBgImage || dark) ? 'text-white/70 hover:text-accent-2' : 'text-muted hover:text-accent']}>
            Home
          </a>
          {breadcrumbs.map((crumb) => {
            const labelText = crumb.label || crumb.name;
            const targetUrl = crumb.href || crumb.url;
            return (
              <div class="flex items-center gap-2">
                <span class={(hasBgImage || dark) ? 'text-white/40' : 'text-stroke'}>/</span>
                {targetUrl ? (
                  <a
                    href={targetUrl}
                    class:list={['hover:underline transition-colors', (hasBgImage || dark) ? 'text-white/70 hover:text-accent-2' : 'text-muted hover:text-accent']}
                  >
                    {labelText}
                  </a>
                ) : (
                  <span class:list={['font-bold', (hasBgImage || dark) ? 'text-accent-2' : 'text-accent']}>
                    {labelText}
                  </span>
                )}
              </div>
            );
          })}
        </nav>
      )
    }

    <div class="space-y-4 max-w-3xl">
      {badgeText && (
        <div data-motion="fade-up">
          <Pill variant={hasBgImage ? 'overlay' : dark ? 'dark' : 'accent'}>{badgeText}</Pill>
        </div>
      )}
      
      <h1 class:list={['text-3xl sm:text-4xl lg:text-5xl font-black font-title tracking-tight leading-tight', (hasBgImage || dark) ? 'text-white drop-shadow-md' : 'text-text']} data-motion="fade-up">
        {title}
      </h1>

      {
        bodyText && (
          <p class:list={['text-base sm:text-lg leading-relaxed font-normal', (hasBgImage || dark) ? 'text-white/90 drop-shadow-xs' : 'text-muted', subtitleClass]} data-motion="fade-up">
            {bodyText}
          </p>
        )
      }

      {
        stats.length > 0 && (
          <div class="gap-4 grid grid-cols-2 sm:grid-cols-3 pt-6">
            {stats.map((st) => (
              <div class="bg-white/10 backdrop-blur-xs p-4 border border-white/10 rounded-xl">
                <div class="font-title font-bold text-2xl text-accent-2">{st.value}</div>
                <div class="text-white/70 text-xs">{st.kicker}</div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
