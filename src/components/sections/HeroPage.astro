---
import Pill from '../ui/Pill.astro';

interface Breadcrumb {
  label?: string;
  name?: string;
  href?: string;
  url?: string;
}

interface StatItem {
  kicker: string;
  value: string;
}

interface Props {
  title: string;
  description?: string;
  subtitle?: string;
  pillText?: string;
  eyebrow?: string;
  breadcrumbs?: Breadcrumb[];
  dark?: boolean;
  image?: any;
  stats?: StatItem[];
}

const {
  title,
  description,
  subtitle,
  pillText,
  eyebrow,
  breadcrumbs = [],
  dark = false,
  stats = [],
} = Astro.props;

const badgeText = pillText || eyebrow;
const bodyText = description || subtitle;
---

<section class:list={['py-16 md:py-20 border-b border-stroke relative overflow-hidden', dark ? 'bg-dark-bg text-white' : 'bg-panel text-text']}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Breadcrumbs -->
    {
      breadcrumbs.length > 0 && (
        <nav class="flex items-center gap-2 text-xs mb-6 font-medium" aria-label="Breadcrumb">
          <a href="/" class:list={['hover:underline transition-colors', dark ? 'text-white/70 hover:text-accent-2' : 'text-muted hover:text-accent']}>
            Home
          </a>
          {breadcrumbs.map((crumb) => {
            const labelText = crumb.label || crumb.name;
            const targetUrl = crumb.href || crumb.url;
            return (
              <div class="flex items-center gap-2">
                <span class={dark ? 'text-white/30' : 'text-stroke'}>/</span>
                {targetUrl ? (
                  <a
                    href={targetUrl}
                    class:list={['hover:underline transition-colors', dark ? 'text-white/70 hover:text-accent-2' : 'text-muted hover:text-accent']}
                  >
                    {labelText}
                  </a>
                ) : (
                  <span class:list={['font-bold', dark ? 'text-accent-2' : 'text-accent']}>
                    {labelText}
                  </span>
                )}
              </div>
            );
          })}
        </nav>
      )
    }

    <div class="max-w-3xl space-y-4">
      {badgeText && <Pill variant={dark ? 'dark' : 'accent'}>{badgeText}</Pill>}
      
      <h1 class:list={['text-3xl sm:text-4xl lg:text-5xl font-black font-title tracking-tight leading-tight', dark ? 'text-white' : 'text-text']}>
        {title}
      </h1>

      {
        bodyText && (
          <p class:list={['text-base sm:text-lg leading-relaxed font-normal', dark ? 'text-white/80' : 'text-muted']}>
            {bodyText}
          </p>
        )
      }

      {
        stats.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6">
            {stats.map((st) => (
              <div class="p-4 rounded-xl bg-white/10 border border-white/10">
                <div class="text-2xl font-bold font-title text-accent-2">{st.value}</div>
                <div class="text-xs text-white/70">{st.kicker}</div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
