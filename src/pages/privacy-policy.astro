---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { company } from '@/data/company';

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Privacy Policy', url: 'https://cfsflooring.com/privacy-policy' },
];
---

<BaseLayout
  title="Privacy Policy | CFS Flooring LLC"
  description="Privacy Policy for CFS Flooring LLC. Learn how we collect, use, and protect your personal information."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="py-16 bg-bg border-b border-stroke">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        kicker="Legal"
        title="Privacy Policy"
        subtitle="Last updated: January 2026"
        class="mb-10"
      />

      <div class="prose prose-lg max-w-none text-muted leading-relaxed flex flex-col gap-6 font-body">
        <p>
          At CFS Flooring LLC, accessible from cfsflooring.com, one of our main priorities is the privacy of our visitors. This Privacy Policy document contains types of information that is collected and recorded by CFS Flooring LLC and how we use it.
        </p>

        <h3 class="text-xl font-bold font-title text-text mt-4">Information We Collect</h3>
        <p>
          When you fill out a quote request or contact form on our website, we may ask for your personal information, including your name, email address, phone number, project address, and details about your flooring project.
        </p>

        <h3 class="text-xl font-bold font-title text-text mt-4">How We Use Your Information</h3>
        <p>
          We use the information we collect to provide, operate, and maintain our website, respond to your inquiries, schedule on-site estimates, and communicate with you regarding your flooring project. We do not sell or rent your personal information to third parties.
        </p>

        <h3 class="text-xl font-bold font-title text-text mt-4">Contact Us</h3>
        <p>
          If you have additional questions or require more information about our Privacy Policy, do not hesitate to contact us at {company.phone}.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
