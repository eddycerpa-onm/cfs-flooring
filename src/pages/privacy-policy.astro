---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPage from '@/components/sections/HeroPage.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { company } from '@/data/company';

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Privacy Policy', url: 'https://cfsflooring.com/privacy-policy' },
];

const sections = [
  { id: 'info-collect', num: '01', title: 'Information We Collect' },
  { id: 'how-we-use', num: '02', title: 'How We Use Your Information' },
  { id: 'text-consent', num: '03', title: 'Text Messages, Calls, & Consent' },
  { id: 'how-we-share', num: '04', title: 'How We Share Information' },
  { id: 'cookies-tracking', num: '05', title: 'Cookies & Tracking Technologies' },
  { id: 'data-retention', num: '06', title: 'Data Retention' },
  { id: 'data-security', num: '07', title: 'Data Security' },
  { id: 'third-party-links', num: '08', title: 'Third-Party Links & Services' },
  { id: 'childrens-privacy', num: '09', title: 'Children’s Privacy' },
  { id: 'your-rights', num: '10', title: 'Your Rights & Choices' },
  { id: 'contact-us', num: '11', title: 'Contact Us' },
  { id: 'policy-changes', num: '12', title: 'Changes to This Privacy Policy' },
];
---

<BaseLayout
  title="Privacy Policy | CFS Flooring LLC"
  description="Privacy Policy for CFS Flooring LLC. Learn how we collect, use, protect, and manage your personal data when requesting flooring installation and remodeling services."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <HeroPage
    eyebrow="Legal Information"
    title="Privacy Policy"
    subtitle="Effective Date: January 1, 2026 | Last Updated: April 2026"
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16 md:py-20 bg-bg">
    <div class="base-container max-w-[1280px] mx-auto px-4 min-[980px]:px-[22px]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sidebar Navigation (Table of Contents) -->
        <aside class="lg:col-span-4 sticky top-28 hidden lg:block">
          <div class="bg-panel border border-stroke rounded-2xl p-6 shadow-[0_18px_45px_rgba(34,20,22,0.06)]">
            <h2 class="text-lg font-black font-title text-text mb-4 pb-3 border-b border-stroke flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-xl bg-accent/15 border border-accent/30 text-accent grid place-items-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
              </span>
              Table of Contents
            </h2>
            <nav class="space-y-1.5 text-sm font-body">
              {sections.map((sec) => (
                <a
                  href={`#${sec.id}`}
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-muted hover:text-text hover:bg-bg border border-transparent hover:border-stroke transition-all duration-200 font-semibold"
                >
                  <span class="text-xs font-mono font-bold text-accent shrink-0">{sec.num}</span>
                  <span class="truncate">{sec.title}</span>
                </a>
              ))}
            </nav>

            <div class="mt-6 pt-6 border-t border-stroke text-xs text-muted space-y-2">
              <div class="font-bold font-title text-text text-sm">Questions about Privacy?</div>
              <p>Contact our support team directly:</p>
              <a href={`tel:${company.phoneRaw}`} class="block font-black font-body text-accent hover:underline text-sm">
                {company.phone}
              </a>
              <a href={`mailto:${company.email}`} class="block text-muted hover:text-text truncate">
                {company.email}
              </a>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="lg:col-span-8 space-y-8">
          
          <!-- Preamble Card -->
          <article class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Overview</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Privacy Policy Overview</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                CFS Flooring LLC (“CFS Flooring,” “we,” “us,” or “our”) respects your privacy and is committed to protecting the personal information you share with us.
                This Privacy Policy explains how we collect, use, disclose, and safeguard information when you visit our website, submit a form, request an estimate,
                communicate with our team, or otherwise interact with our services. This policy applies to visitors and customers in Oregon and the United States.
              </p>
            </div>
          </article>

          <!-- Mobile Quick Index -->
          <div class="block lg:hidden bg-panel border border-stroke rounded-2xl p-5 mb-8 shadow-sm">
            <details class="group">
              <summary class="cursor-pointer font-bold font-title text-text flex items-center justify-between">
                <span class="flex items-center gap-2.5">
                  <span class="w-7 h-7 rounded-lg bg-accent/15 text-accent grid place-items-center shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                    </svg>
                  </span>
                  Quick Section Jump
                </span>
                <svg class="w-5 h-5 text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-4 pt-4 border-t border-stroke grid grid-cols-1 gap-2 text-sm">
                {sections.map((sec) => (
                  <a href={`#${sec.id}`} class="text-muted hover:text-accent py-1 font-medium flex items-center gap-2">
                    <span class="text-xs font-mono text-accent font-bold">{sec.num}</span>
                    <span>{sec.title}</span>
                  </a>
                ))}
              </div>
            </details>
          </div>

          <!-- Section 1 -->
          <article id="info-collect" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 01</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Information We Collect</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                We may collect information you provide directly to us, as well as certain information collected automatically through your use of our website.
              </p>
              <ul class="space-y-2 pl-4 list-disc marker:text-accent">
                <li><strong>Contact information:</strong> name, phone number, email address, and property address if you provide it.</li>
                <li><strong>Project information:</strong> details about the flooring services you are requesting, including room types, material interests, project timing, budget preferences, and any notes, photos, or files you choose to submit.</li>
                <li><strong>Website usage information:</strong> IP address, browser type, device information, general location, pages visited, and interactions collected through cookies or similar technologies.</li>
              </ul>
            </div>
          </article>

          <!-- Section 2 -->
          <article id="how-we-use" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 02</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">How We Use Your Information</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                We may use your information for legitimate business purposes, including:
              </p>
              <ul class="space-y-2 pl-4 list-disc marker:text-accent">
                <li>Responding to your inquiries and requests for estimates, consultations, or service information.</li>
                <li>Providing recommendations, scheduling appointments, confirming visits, and communicating about your project.</li>
                <li>Improving our website, services, customer communications, and overall user experience.</li>
                <li>Maintaining website security, preventing fraud, and diagnosing technical issues.</li>
                <li>Complying with applicable laws, regulations, legal processes, and enforceable requests.</li>
              </ul>
            </div>
          </article>

          <!-- Section 3 -->
          <article id="text-consent" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 03</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Text Messages, Calls, and Consent</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                If you provide your phone number, you consent to receive calls and/or text messages from us related to your inquiry, estimate request, scheduling,
                appointment reminders, project updates, and customer service follow-up. Message frequency may vary. Message and data rates may apply based on your carrier plan.
                You may opt out of non-essential text communications at any time by replying STOP or by contacting us directly.
              </p>
            </div>
          </article>

          <!-- Section 4 -->
          <article id="how-we-share" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 04</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">How We Share Information</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                We do not sell your personal information. We may share information with trusted third-party service providers that help us operate our website,
                forms, communications, customer relationship management tools, analytics tools, and related business systems, but only as reasonably necessary
                to provide our services or operate our business. We may also disclose information when required by law or when we reasonably believe disclosure
                is necessary to protect our rights, property, safety, users, or others.
              </p>
            </div>
          </article>

          <!-- Section 5 -->
          <article id="cookies-tracking" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 05</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Cookies and Tracking Technologies</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Our website may use cookies, pixels, analytics tools, and similar technologies to understand website traffic, improve performance, and enhance user experience.
                You can control cookies through your browser settings. Disabling cookies may affect the functionality of certain parts of the website.
              </p>
            </div>
          </article>

          <!-- Section 6 -->
          <article id="data-retention" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 06</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Data Retention</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                We retain information for as long as reasonably necessary to fulfill the purposes described in this Privacy Policy, provide requested services,
                maintain business records, resolve disputes, enforce agreements, and comply with legal obligations.
              </p>
            </div>
          </article>

          <!-- Section 7 -->
          <article id="data-security" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 07</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Data Security</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                We use reasonable administrative, technical, and physical safeguards designed to protect your personal information. However, no website, online form,
                or electronic transmission method can be guaranteed to be completely secure. For that reason, you should avoid sending highly sensitive information
                through general website forms unless specifically requested through a secure method.
              </p>
            </div>
          </article>

          <!-- Section 8 -->
          <article id="third-party-links" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 08</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Third-Party Links and Services</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Our website may contain links to third-party websites, tools, or services. We are not responsible for the privacy practices, content, or policies
                of third parties. We encourage you to review their privacy policies separately before submitting information to them.
              </p>
            </div>
          </article>

          <!-- Section 9 -->
          <article id="childrens-privacy" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 09</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Children’s Privacy</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Our website and services are not directed to children under the age of 13, and we do not knowingly collect personal information from children under 13.
                If you believe a child has provided us with personal information, please contact us so we can take appropriate action.
              </p>
            </div>
          </article>

          <!-- Section 10 -->
          <article id="your-rights" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 10</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Your Rights and Choices</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Depending on where you live, you may have the right to request access to, correction of, or deletion of personal information you have provided to us,
                subject to applicable legal exceptions. You may also opt out of certain communications by contacting us using the information below.
              </p>
            </div>
          </article>

          <!-- Section 11 -->
          <article id="contact-us" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Section 11</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Contact Us</h2>
              </div>
            </header>
            <div class="bg-bg border border-stroke rounded-xl p-5 space-y-3 font-body">
              <p class="font-black font-title text-text text-lg">CFS Flooring LLC</p>
              <div class="flex flex-col sm:flex-row gap-4 text-sm">
