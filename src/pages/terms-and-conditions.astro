---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPage from '@/components/sections/HeroPage.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { company } from '@/data/company';

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Terms & Conditions', url: 'https://cfsflooring.com/terms-and-conditions' },
];

const sections = [
  { id: 'sec-1', num: '01', title: '1) Website Use' },
  { id: 'sec-2', num: '02', title: '2) Estimates, Requests, & Communications' },
  { id: 'sec-3', num: '03', title: '3) Appointments & Availability' },
  { id: 'sec-4', num: '04', title: '4) Estimates & Project Scope' },
  { id: 'sec-5', num: '05', title: '5) Flooring Conditions & Site Variables' },
  { id: 'sec-6', num: '06', title: '6) Third-Party Tools & Links' },
  { id: 'sec-7', num: '07', title: '7) Intellectual Property' },
  { id: 'sec-8', num: '08', title: '8) No Warranty' },
  { id: 'sec-9', num: '09', title: '9) Limitation of Liability' },
  { id: 'sec-10', num: '10', title: '10) Indemnification' },
  { id: 'sec-11', num: '11', title: '11) Changes to These Terms' },
  { id: 'sec-12', num: '12', title: '12) Governing Law' },
];
---

<BaseLayout
  title="Terms & Conditions | CFS Flooring LLC"
  description="Terms and Conditions governing the use of CFS Flooring LLC website, estimate tools, and flooring installation services."
>
  <BreadcrumbSchema items={breadcrumbs} />

  <HeroPage
    eyebrow="Legal Information"
    title="Terms & Conditions"
    subtitle="Effective Date: January 1, 2026 | Last Updated: April 2026"
    breadcrumbs={breadcrumbs}
  />

  <section class="py-16 md:py-20 bg-bg">
    <div class="cfs-base-container max-w-[1280px] mx-auto px-4 min-[980px]:px-[22px]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sidebar Navigation (Table of Contents) -->
        <aside class="lg:col-span-4 sticky top-28 hidden lg:block">
          <div class="bg-panel border border-stroke rounded-2xl p-6 shadow-[0_18px_45px_rgba(34,20,22,0.06)]">
            <h2 class="text-lg font-black font-title text-text mb-4 pb-3 border-b border-stroke flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-xl bg-accent/15 border border-accent/30 text-accent grid place-items-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
              </span>
              Table of Contents
            </h2>
            <nav class="space-y-1.5 text-sm font-body">
              {sections.map((sec) => (
                <a
                  href={`#${sec.id}`}
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-muted hover:text-text hover:bg-bg border border-transparent hover:border-stroke transition-all duration-200 font-semibold"
                >
                  <span class="text-xs font-mono font-bold text-accent shrink-0">{sec.num}</span>
                  <span class="truncate">{sec.title}</span>
                </a>
              ))}
            </nav>

            <div class="mt-6 pt-6 border-t border-stroke text-xs text-muted space-y-2">
              <div class="font-bold font-title text-text text-sm">Questions about Terms?</div>
              <p>Contact our support team directly:</p>
              <a href={`tel:${company.phoneRaw}`} class="block font-black font-body text-accent hover:underline text-sm">
                {company.phone}
              </a>
              <a href={`mailto:${company.email}`} class="block text-muted hover:text-text truncate">
                {company.email}
              </a>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="lg:col-span-8 space-y-8">
          
          <!-- Preamble Card -->
          <article class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Overview</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">Agreement to Terms</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                These Terms &amp; Conditions (“Terms”) govern your access to and use of the CFS Flooring LLC (“CFS Flooring,” “we,” “us,” or “our”) website,
                online forms, estimate request tools, and related communications. By using this website, submitting your information, or otherwise interacting
                with our online services, you agree to be bound by these Terms. If you do not agree, please do not use this website.
              </p>
            </div>
          </article>

          <!-- Mobile Quick Index -->
          <div class="block lg:hidden bg-panel border border-stroke rounded-2xl p-5 mb-8 shadow-sm">
            <details class="group">
              <summary class="cursor-pointer font-bold font-title text-text flex items-center justify-between">
                <span class="flex items-center gap-2.5">
                  <span class="w-7 h-7 rounded-lg bg-accent/15 text-accent grid place-items-center shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                    </svg>
                  </span>
                  Quick Section Jump
                </span>
                <svg class="w-5 h-5 text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-4 pt-4 border-t border-stroke grid grid-cols-1 gap-2 text-sm">
                {sections.map((sec) => (
                  <a href={`#${sec.id}`} class="text-muted hover:text-accent py-1 font-medium flex items-center gap-2">
                    <span class="text-xs font-mono text-accent font-bold">{sec.num}</span>
                    <span>{sec.title}</span>
                  </a>
                ))}
              </div>
            </details>
          </div>

          <!-- Section 1 -->
          <article id="sec-1" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 01</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">1) Website Use</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                You agree to use this website only for lawful purposes and in accordance with these Terms. You may not use the website in any way that could
                damage, disable, overburden, interfere with, or impair the website or our services. You may not attempt to gain unauthorized access to any
                portion of the website, submit false or misleading information, introduce malicious code, or misuse contact forms or communication tools.
              </p>
            </div>
          </article>

          <!-- Section 2 -->
          <article id="sec-2" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 02</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">2) Estimates, Requests, and Communications</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Any information submitted through our website, including contact forms and estimate requests, is provided for general inquiry and scheduling purposes.
                Submission of a form does not guarantee service, pricing, availability, or project acceptance. By providing your phone number and email address,
                you authorize us to contact you regarding your request, including by phone, email, and text message, as permitted by applicable law. Message and
                data rates may apply depending on your carrier and mobile plan.
              </p>
            </div>
          </article>

          <!-- Section 3 -->
          <article id="sec-3" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 03</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">3) Appointments and Availability</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Appointment requests, consultations, and estimate visits are subject to confirmation by our team. Scheduling and project availability may vary
                based on location, project scope, staffing, material availability, weather, access conditions, and other business or field conditions. We reserve
                the right to reschedule appointments when reasonably necessary.
              </p>
            </div>
          </article>

          <!-- Section 4 -->
          <article id="sec-4" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 04</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">4) Estimates and Project Scope</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Any estimate, consultation, recommendation, or project discussion provided through the website or during an initial review is preliminary unless
                otherwise stated in a written agreement. Final pricing, timelines, materials, and project scope may depend on field verification, measurements,
                subfloor conditions, product availability, changes requested by the customer, and other site-specific factors. No binding contractor-client
                relationship is created until a formal agreement is executed by the appropriate parties.
              </p>
            </div>
          </article>

          <!-- Section 5 -->
          <article id="sec-5" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0v-4m0 4h4m-4 0v-4" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 05</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">5) Flooring Conditions and Site Variables</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Flooring and finish projects may involve concealed conditions or variable site factors, including uneven subfloors, moisture issues, damaged
                underlying materials, transition changes, removal complications, code-related requirements, or access limitations. Discovery of such conditions
                may affect project scope, pricing, products, labor needs, and completion timelines. Any material change will be communicated as applicable.
              </p>
            </div>
          </article>

          <!-- Section 6 -->
          <article id="sec-6" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 06</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">6) Third-Party Tools and Links</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                Our website may include or link to third-party tools and services, including form providers, maps, embedded media, analytics, customer
                communication platforms, and other external systems. These third parties operate independently and may have separate terms, privacy policies,
                and practices. We are not responsible for the performance, content, availability, or information practices of third-party services.
              </p>
            </div>
          </article>

          <!-- Section 7 -->
          <article id="sec-7" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 07</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">7) Intellectual Property</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                All content on this website, including text, graphics, logos, branding, layouts, images, videos, and design elements, is owned by CFS Flooring
                or used with permission and is protected by applicable intellectual property laws. You may not copy, reproduce, modify, republish, distribute,
                display, or otherwise use website content without prior written permission, except as allowed under applicable law.
              </p>
            </div>
          </article>

          <!-- Section 8 -->
          <article id="sec-8" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 08</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">8) No Warranty</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                This website and its content are provided on an “as is” and “as available” basis without warranties of any kind, express or implied, including
                but not limited to warranties of accuracy, completeness, merchantability, fitness for a particular purpose, or non-infringement. We do not
                guarantee that the website will be uninterrupted, error-free, secure, or free from harmful components.
              </p>
            </div>
          </article>

          <!-- Section 9 -->
          <article id="sec-9" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 09</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">9) Limitation of Liability</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                To the fullest extent permitted by law, CFS Flooring shall not be liable for any indirect, incidental, consequential, special, exemplary, or
                punitive damages arising out of or relating to your use of the website, reliance on website information, or interaction with third-party services,
                even if advised of the possibility of such damages. To the extent liability cannot be excluded, our total liability shall be limited to the amount,
                if any, paid directly to us for services specifically related to the claim.
              </p>
            </div>
          </article>

          <!-- Section 10 -->
          <article id="sec-10" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
              <span class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/25 text-accent grid place-items-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                </svg>
              </span>
              <div>
                <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">Clause 10</span>
                <h2 class="text-xl md:text-2xl font-black font-title text-text">10) Indemnification</h2>
              </div>
            </header>
            <div class="prose max-w-none text-muted font-body leading-relaxed space-y-3">
              <p>
                You agree to defend, indemnify, and hold harmless CFS Flooring, its owners, employees, contractors, and service providers from and against any
                claims, liabilities, damages, losses, and expenses arising out of or related to your misuse of the website, your violation of these Terms, or
                your infringement of any rights of another party.
              </p>
            </div>
          </article>

          <!-- Section 11 -->
          <article id="sec-11" class="bg-panel border border-stroke rounded-2xl p-6 md:p-8 space-y-4 hover:border-accent/40 transition-colors shadow-[0_18px_45px_rgba(34,20,22,0.04)]">
            <header class="flex items-center gap-3.5 border-b border-stroke pb-4">
