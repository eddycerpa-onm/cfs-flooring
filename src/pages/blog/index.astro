---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
import Pill from '@/components/ui/Pill.astro';
import { Image } from 'astro:assets';
import { blogPosts } from '@/data/blog';

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Blog', url: 'https://cfsflooring.com/blog' },
];
---

<BaseLayout
  title="Flooring Blog & Guides | Portland, Lake Oswego, West Linn, Wilsonville | CFS Flooring"
  description="Expert flooring guides and insights on hardwood refinishing, waterproof LVP, commercial VCT, and custom tile for homes and businesses in Portland, Lake Oswego, West Linn, and Wilsonville, OR."
>
  <LocalBusiness />
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- Hero Header Section -->
  <section class="py-16 md:py-20 bg-gradient-to-b from-bg to-panel border-b border-stroke">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        pillText="Local Flooring Insights"
        title="Expert Flooring Guides for Portland Metro Homeowners & Businesses"
        description="Tips, trends, and expert advice on hardwood refinishing, waterproof LVP, commercial vinyl, and custom tile installation across Lake Oswego, West Linn, Wilsonville, and Portland."
      />

      <!-- Geo Service Tag Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12" data-motion="fade-up">
        <span class="text-xs font-bold text-muted uppercase tracking-wider mr-2">Serving:</span>
        <span class="px-3 py-1 rounded-full bg-white border border-stroke text-xs font-semibold text-text shadow-xs">Portland, OR</span>
        <span class="px-3 py-1 rounded-full bg-white border border-stroke text-xs font-semibold text-text shadow-xs">Lake Oswego, OR</span>
        <span class="px-3 py-1 rounded-full bg-white border border-stroke text-xs font-semibold text-text shadow-xs">West Linn, OR</span>
        <span class="px-3 py-1 rounded-full bg-white border border-stroke text-xs font-semibold text-text shadow-xs">Wilsonville, OR</span>
      </div>

      <!-- Blog Posts Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {blogPosts.map((post) => (
          <article class="flex flex-col rounded-3xl bg-bg border border-stroke shadow-md hover:shadow-xl hover:border-accent/40 transition-all duration-300 overflow-hidden group" data-motion="fade-up">
            <!-- Article Image -->
            <a href={`/blog/${post.slug}`} aria-label={`Read article: ${post.title}`} class="block relative aspect-video overflow-hidden bg-panel">
              <Image
                src={post.image}
                alt={post.imageAlt}
                width={640}
                height={360}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                <Pill variant="overlay">{post.category}</Pill>
              </div>
            </a>

            <!-- Article Details -->
            <div class="p-6 md:p-8 flex flex-col justify-between flex-1">
              <div>
                <div class="flex items-center justify-between text-xs text-muted font-medium mb-3">
                  <span class="inline-flex items-center gap-1.5 text-accent font-semibold">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {post.geoTarget}
                  </span>
                  <span>{post.readTime}</span>
                </div>

                <h2 class="text-xl md:text-2xl font-bold font-title text-text group-hover:text-accent transition-colors mb-3 leading-snug">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>

                <p class="text-sm md:text-base text-muted line-clamp-3 leading-relaxed mb-6 font-body">
                  {post.description}
                </p>
              </div>

              <!-- Footer meta -->
              <div class="pt-4 border-t border-stroke flex items-center justify-between text-xs font-body">
                <span class="text-muted font-medium">By {post.author}</span>
                <a href={`/blog/${post.slug}`} aria-label={`Read article: ${post.title}`} class="font-bold font-title text-accent hover:underline inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  <span>Read Article</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABanner title="Have Questions About Your Flooring Project?" subtitle="Speak directly with our team to schedule a free on-site estimate in Lake Oswego, West Linn, Wilsonville, or Portland." />
</BaseLayout>
