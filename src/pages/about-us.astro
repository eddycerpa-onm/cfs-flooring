---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';

import AboutHero from '@/components/about/AboutHero.astro';
import WhyChooseUs from '@/components/about/WhyChooseUs.astro';
import AboutTabbed from '@/components/about/AboutTabbed.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import CTABanner from '@/components/sections/CTABanner.astro';

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'About Us', url: 'https://cfsflooring.com/about-us' },
];
---

<BaseLayout
  title="About CFS Flooring | 10+ Years Flooring Installation & Refinishing Expertise"
  description="Learn more about CFS Flooring LLC. Over 10 years serving Lake Oswego, West Linn, Wilsonville, Portland, and Vancouver WA with expert flooring repair, replacement, refinishing, and redesign."
>
  <LocalBusiness />
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- 1. Hero Section -->
  <AboutHero />

  <!-- 2. Why Choose Us Section -->
  <WhyChooseUs />

  <!-- 3. Tabbed Approach Section (Different, Mission, Process) -->
  <AboutTabbed />

  <!-- 4. Testimonials Section -->
  <Testimonials />

  <!-- 5. CTA Banner Section -->
  <CTABanner />
</BaseLayout>
