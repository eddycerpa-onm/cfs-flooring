---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import { navigationData } from '@/data/navigation';

const popularServices = navigationData.servicesNav.slice(0, 4);
---

<BaseLayout
  title="404: Page Not Found | CFS Flooring"
  description="The page you are looking for does not exist or has been moved. Explore our flooring and painting services in Lake Oswego & West Linn."
  noindex={true}
>
  <LocalBusiness />

  <section class="min-h-[80vh] flex items-center justify-center py-20 px-4 relative overflow-hidden bg-dark-bg text-white font-body">
    <!-- Ambient Background Lighting & Blueprint Grid -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(217,119,6,0.12)_0%,transparent_70%)] pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.04] bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

    <div class="max-w-3xl mx-auto text-center relative z-10 space-y-8">
      <!-- 404 Badge & Big Number -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/15 border border-accent/30 text-accent text-xs font-bold font-title tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        404 &bull; Page Off-Pattern
      </div>

      <div class="relative select-none">
        <h1 class="text-8xl sm:text-9xl font-black font-title tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-white via-white/80 to-white/20 drop-shadow-2xl">
          404
        </h1>
        <div class="text-xl sm:text-2xl font-bold font-title text-accent-2 mt-2">
          Looks Like You've Stepped Off the Layout
        </div>
      </div>

      <p class="text-base sm:text-lg text-white/70 max-w-xl mx-auto leading-relaxed">
        The page you are looking for doesn't exist or has been relocated. Don't worry—our team is still here to deliver flawless flooring and painting craftsmanship.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <Button href="/" variant="primary" size="lg">
          &larr; Return to Homepage
        </Button>
        <Button href="/our-services" variant="outline" size="lg" class="text-white border-white/30 hover:bg-white/10">
          Explore All Services
        </Button>
      </div>

      <!-- Quick Services Directory -->
      <div class="pt-10 border-t border-white/10 mt-10">
        <p class="text-xs uppercase tracking-widest text-white/50 font-title font-bold mb-6">
          Or Jump Directly To Popular Services
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
          {
            popularServices.map((service) => (
              <a
                href={service.href}
                class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-accent/50 hover:bg-white/10 transition-all group block"
              >
                <div class="text-sm font-bold font-title text-white group-hover:text-accent transition-colors flex items-center justify-between">
                  <span>{service.shortTitle}</span>
                  <span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent">&rarr;</span>
                </div>
                <p class="text-xs text-white/60 mt-1 line-clamp-2 leading-relaxed">
                  {service.description}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
