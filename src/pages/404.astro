---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import { navigationData } from '@/data/navigation';

const popularServices = navigationData.servicesNav.slice(0, 4);
---

<BaseLayout
  title="404: Page Not Found | CFS Flooring"
  description="The page you are looking for does not exist or has been moved. Explore our flooring and painting services in Lake Oswego & West Linn."
  noindex={true}
>
  <LocalBusiness />

  <section class="min-h-[80vh] flex items-center justify-center py-20 px-4 relative overflow-hidden bg-bg text-text font-body">
    <!-- Ambient Background Lighting -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(176,127,73,0.06)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="max-w-3xl mx-auto text-center relative z-10 space-y-8">
      <!-- 404 Badge & Big Number -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-panel border border-stroke text-accent text-xs font-bold font-title tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        404 &bull; Page Off-Pattern
      </div>

      <div class="relative select-none">
        <h1 class="text-8xl sm:text-9xl font-black font-title tracking-tighter text-accent drop-shadow-sm">
          404
        </h1>
        <div class="text-xl sm:text-2xl font-bold font-title text-text mt-2">
          Looks Like You've Stepped Off the Layout
        </div>
      </div>

      <p class="text-base sm:text-lg text-muted max-w-xl mx-auto leading-relaxed">
        The page you are looking for doesn't exist or has been relocated. Don't worry—our team is still here to deliver flawless flooring and painting craftsmanship.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <Button href="/" variant="primary" size="lg">
          &larr; Return to Homepage
        </Button>
        <Button href="/our-services" variant="outline" size="lg" class="text-text border-stroke hover:bg-panel">
          Explore All Services
        </Button>
      </div>

      <!-- Quick Services Directory -->
      <div class="pt-10 border-t border-stroke mt-10">
        <p class="text-xs uppercase tracking-widest text-muted font-title font-bold mb-6">
          Or Jump Directly To Popular Services
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
          {
            popularServices.map((service) => (
              <a
                href={service.href}
                class="p-5 rounded-2xl bg-panel border border-stroke hover:border-accent hover:shadow-md transition-all group block"
              >
                <div class="text-base font-bold font-title text-text group-hover:text-accent transition-colors flex items-center justify-between mb-2">
                  <span>{service.shortTitle}</span>
                  <span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent">&rarr;</span>
                </div>
                <p class="text-sm text-muted line-clamp-2 leading-relaxed">
                  {service.description}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
