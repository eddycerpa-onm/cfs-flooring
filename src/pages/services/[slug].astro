---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroService from '@/components/sections/HeroService.astro';
import ServiceDetails from '@/components/services/ServiceDetails.astro';
import ServiceProcessSteps from '@/components/services/ServiceProcessSteps.astro';
import RelatedServicesNav from '@/components/services/RelatedServicesNav.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import ServiceSchema from '@/components/seo/ServiceSchema.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import FAQSchema from '@/components/seo/FAQSchema.astro';
import { services, type ServiceItem } from '@/data/services';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const {
  title,
  slug,
  subtitle,
  description,
  metaTitle,
  metaDescription,
  image,
  heroBadge,
  features,
  detailedFeatures,
  processSteps,
  specifications,
  applications,
  faqs,
} = service;

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Services', url: 'https://cfsflooring.com/our-services' },
  { name: title, url: `https://cfsflooring.com/services/${slug}` },
];
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <LocalBusiness />
  <ServiceSchema name={title} description={description} url={`https://cfsflooring.com/services/${slug}`} />
  <BreadcrumbSchema items={breadcrumbs} />
  {faqs && faqs.length > 0 && <FAQSchema faqs={faqs} />}

  <!-- Hero Section -->
  <HeroService
    title={title}
    description={description}
    image={image}
    features={features}
    slug={slug}
    heroBadge={heroBadge}
  />

  <!-- Detailed Features & Specs Section -->
  <ServiceDetails
    title={title}
    subtitle={subtitle}
    features={features}
    detailedFeatures={detailedFeatures}
    specifications={specifications}
    applications={applications}
  />

  <!-- Process Steps Section -->
  <ServiceProcessSteps steps={processSteps} />

  <!-- FAQs Section -->
  {faqs && faqs.length > 0 && <FAQ faqs={faqs} title={`Frequently Asked Questions: ${title}`} />}

  <!-- Related Services -->
  <RelatedServicesNav currentSlug={slug} />

  <!-- Call to Action Banner -->
  <CTABanner title={`Get a Free Estimate on ${title}`} />
</BaseLayout>
