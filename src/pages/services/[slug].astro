---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroService from '@/components/sections/HeroService.astro';
import ServiceDetails from '@/components/services/ServiceDetails.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
import FAQ from '@/components/sections/FAQ.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import ServiceSchema from '@/components/seo/ServiceSchema.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { services, type ServiceItem } from '@/data/services';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const {
  title,
  slug,
  subtitle,
  description,
  metaTitle,
  metaDescription,
  image,
  heroBadge,
  features,
  detailedFeatures,
  specifications,
  applications,
  faqs,
  seoTitle,
  seoText,
} = service;

const breadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Services', url: 'https://cfsflooring.com/our-services' },
  { name: title, url: `https://cfsflooring.com/services/${slug}` },
];
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <LocalBusiness />
  <ServiceSchema name={title} description={description} url={`https://cfsflooring.com/services/${slug}`} />
  <BreadcrumbSchema items={breadcrumbs} />

  <!-- Hero Section -->
  <HeroService
    title={title}
    heroTitle={description}
    subtitle={subtitle}
    description={description}
    image={image}
    features={features}
    slug={slug}
    heroBadge={heroBadge}
  />

  <!-- Service Details Section -->
  <ServiceDetails
    title={title}
    subtitle={subtitle}
    image={image}
    features={features}
    detailedFeatures={detailedFeatures}
    specifications={specifications}
    applications={applications}
    seoTitle={seoTitle}
    seoText={seoText}
  />

  <!-- Call to Action Banner -->
  <CTABanner title={`Get a Free Estimate on ${title}`} />

  <!-- FAQ Section -->
  <FAQ faqs={faqs} />
</BaseLayout>
