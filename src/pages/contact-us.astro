---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPage from '@/components/sections/HeroPage.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import LocalBusiness from '@/components/seo/LocalBusiness.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Pill from '@/components/ui/Pill.astro';
import { company } from '@/data/company';
import { Image } from 'astro:assets';

import contactHeroImg from '@/assets/about/hero.webp';
import showcaseImg from '@/assets/services/hardwood-lvp.webp';

const schemaBreadcrumbs = [
  { name: 'Home', url: 'https://cfsflooring.com' },
  { name: 'Contact Us', url: 'https://cfsflooring.com/contact-us' },
];

const heroBreadcrumbs = [
  { label: 'Contact Us', href: '/contact-us' },
];

const oregonAreas = company.serviceAreas.filter((a) => a.state === 'OR');
const washingtonAreas = company.serviceAreas.filter((a) => a.state === 'WA');
---

<BaseLayout
  title="Contact CFS Flooring | Schedule Free Estimate in Lake Oswego & Portland"
  description="Contact CFS Flooring to schedule a free estimate for hardwood, LVP, carpet, or tile installation. Call (971) 419-8602 or email cfsflooringllc@outlook.com."
>
  <LocalBusiness />
  <BreadcrumbSchema items={schemaBreadcrumbs} />

  <!-- Hero Header -->
  <HeroPage
    eyebrow="Contact Us"
    title="Get in Touch with CFS Flooring"
    subtitle="Ready to transform your home or commercial space? Contact our team for a free on-site estimate, material guidance, or project consultation."
    breadcrumbs={heroBreadcrumbs}
    image={contactHeroImg}
    subtitleClass="!text-white"
  />

  <!-- Main Contact Section: Form + Direct Details -->
  <section class="py-16 md:py-24 bg-bg border-b border-stroke">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Direct Contact Info Column (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <Pill variant="accent" class="mb-4">Direct Contact</Pill>
            <h2 class="text-3xl font-black font-title text-text tracking-tight">
              We're Here to Help Your Flooring Project Succeed
            </h2>
            <p class="text-muted mt-3 text-base leading-relaxed font-body">
              Whether you need solid hardwood refinishing, waterproof LVP, luxury tile, or complete carpet replacement, our team provides personal consultation and transparent pricing.
            </p>
          </div>

          <!-- Contact Details Cards -->
          <div class="space-y-4 font-body">
            <!-- Phone Box -->
            <a
              href={`tel:${company.phoneRaw}`}
              class="group flex items-start gap-4 p-5 rounded-2xl bg-panel border border-stroke hover:border-accent hover:shadow-md transition-all duration-300"
            >
              <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold font-title text-muted uppercase tracking-wider block">Call or Text Direct</span>
                <span class="text-xl font-bold font-title text-text group-hover:text-accent transition-colors block mt-0.5">
                  {company.phone}
                </span>
                <span class="text-xs text-muted mt-1 block">Speak directly with our senior estimators</span>
              </div>
            </a>

            <!-- Email Box -->
            <a
              href={`mailto:${company.email}`}
              class="group flex items-start gap-4 p-5 rounded-2xl bg-panel border border-stroke hover:border-accent hover:shadow-md transition-all duration-300"
            >
              <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold font-title text-muted uppercase tracking-wider block">Email Consultation</span>
                <span class="text-base font-bold font-title text-text group-hover:text-accent transition-colors block mt-0.5 break-all">
                  {company.email}
                </span>
                <span class="text-xs text-muted mt-1 block">Send blueprints, floor plans, or photo inquiries</span>
              </div>
            </a>

            <!-- Location Box -->
            <div class="flex items-start gap-4 p-5 rounded-2xl bg-panel border border-stroke">
              <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold font-title text-muted uppercase tracking-wider block">Office & Dispatch</span>
                <span class="text-sm font-bold font-title text-text block mt-0.5">
                  {company.address.street}
                </span>
                <span class="text-xs text-muted block">
                  {company.address.city}, {company.address.state} {company.address.zip}
                </span>
              </div>
            </div>

            <!-- Hours Box -->
            <div class="flex items-start gap-4 p-5 rounded-2xl bg-panel border border-stroke">
              <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-xs space-y-1">
                <span class="font-bold font-title text-muted uppercase tracking-wider block">Hours of Operation</span>
                <p class="text-text font-medium">{company.hours.weekdays}</p>
                <p class="text-text font-medium">{company.hours.saturday}</p>
                <p class="text-muted">{company.hours.sunday}</p>
              </div>
            </div>

            <!-- License Info Box -->
            <div class="p-4 rounded-xl bg-dark-bg text-white space-y-1 text-xs">
              <div class="font-bold font-title text-accent-2 uppercase tracking-wider">Licensed & Fully Insured Contractor</div>
              <div class="flex flex-wrap justify-between gap-2 text-white/80 pt-1">
                <span>Oregon CCB: <strong class="text-white">{company.licenses.oregonCCB}</strong></span>
                <span>Washington Lic: <strong class="text-white">{company.licenses.washingtonLic}</strong></span>
              </div>
            </div>
          </div>

          <!-- Astro Image Visual Card -->
          <div class="relative rounded-3xl overflow-hidden shadow-xl border border-stroke group">
            <Image
              src={showcaseImg}
              alt="CFS Flooring craftsmanship sample"
              class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-bg/95 via-dark-bg/75 to-transparent p-6 flex flex-col justify-end">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-2 font-title">Craftsmanship Guaranteed</span>
              <p class="text-sm font-semibold !text-white mt-1 drop-shadow-sm">
                Over 1,500 successfully installed floors across Lake Oswego, West Linn, & Vancouver.
              </p>
            </div>
          </div>

        </div>

        <!-- Form Column (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- Service Areas Breakdown Section -->
  <section class="py-16 md:py-20 bg-panel border-b border-stroke">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        kicker="Service Coverage"
        title="Areas We Serve in Oregon & Washington"
        subtitle="We bring samples and on-site measurements directly to your home or office across the Greater Portland Metro & SW Washington."
        centered={true}
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Oregon Service Areas -->
        <div class="p-8 rounded-3xl bg-white border border-stroke shadow-sm space-y-6">
          <div class="flex items-center gap-3 border-b border-stroke pb-4">
            <div class="w-10 h-10 rounded-full bg-accent/10 text-accent flex items-center justify-center font-bold font-title">
              OR
            </div>
            <div>
              <h3 class="text-xl font-bold font-title text-text">Oregon Communities</h3>
              <p class="text-xs text-muted">Clackamas, Multnomah & Washington Counties</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            {oregonAreas.map((area) => (
              <span
                class:list={[
                  'px-3.5 py-2 rounded-xl text-xs font-medium font-body transition-colors',
                  area.popular
                    ? 'bg-accent/10 text-accent font-bold border border-accent/20'
                    : 'bg-panel text-text border border-stroke',
                ]}
              >
                {area.city}, OR {area.popular && '★'}
              </span>
            ))}
          </div>
          <p class="text-xs text-muted italic">
            ★ Primary service focus area with fast scheduling for on-site estimates.
          </p>
        </div>

        <!-- Washington Service Areas -->
        <div class="p-8 rounded-3xl bg-white border border-stroke shadow-sm space-y-6">
          <div class="flex items-center gap-3 border-b border-stroke pb-4">
            <div class="w-10 h-10 rounded-full bg-accent/10 text-accent flex items-center justify-center font-bold font-title">
              WA
            </div>
            <div>
              <h3 class="text-xl font-bold font-title text-text">Washington Communities</h3>
              <p class="text-xs text-muted">Clark County & Surrounding SW Washington</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            {washingtonAreas.map((area) => (
              <span
                class:list={[
                  'px-3.5 py-2 rounded-xl text-xs font-medium font-body transition-colors',
                  area.popular
                    ? 'bg-accent/10 text-accent font-bold border border-accent/20'
                    : 'bg-panel text-text border border-stroke',
                ]}
              >
                {area.city}, WA {area.popular && '★'}
              </span>
            ))}
          </div>
          <p class="text-xs text-muted italic">
            Licensed in Washington State ({company.licenses.washingtonLic}).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimate Expectation Highlights -->
  <section class="py-16 bg-bg border-b border-stroke">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-panel border border-stroke text-center space-y-3 font-body">
          <div class="w-12 h-12 rounded-full bg-accent/10 text-accent flex items-center justify-center mx-auto text-xl font-bold font-title">
            1
          </div>
          <h4 class="text-lg font-bold font-title text-text">Fast On-Site Response</h4>
          <p class="text-xs text-muted leading-relaxed">
            We review estimate requests promptly and schedule an on-site visit at a time convenient for you.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-panel border border-stroke text-center space-y-3 font-body">
          <div class="w-12 h-12 rounded-full bg-accent/10 text-accent flex items-center justify-center mx-auto text-xl font-bold font-title">
            2
          </div>
          <h4 class="text-lg font-bold font-title text-text">Transparent Pricing</h4>
          <p class="text-xs text-muted leading-relaxed">
            Clear detailed estimates covering demolition, subfloor preparation, materials, and labor with zero hidden fees.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-panel border border-stroke text-center space-y-3 font-body">
          <div class="w-12 h-12 rounded-full bg-accent/10 text-accent flex items-center justify-center mx-auto text-xl font-bold font-title">
            3
          </div>
          <h4 class="text-lg font-bold font-title text-text">Clean & Reliable Service</h4>
          <p class="text-xs text-muted leading-relaxed">
            Our experienced installation crews protect your property and clean up thoroughly after completion.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <Testimonials />
</BaseLayout>

